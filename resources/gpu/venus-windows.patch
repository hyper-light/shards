diff --color -ruN pristine/virglrenderer-0.10.4e-krunkit/src/shards_vulkan_win32.c src/virglrenderer-0.10.4e-krunkit/src/shards_vulkan_win32.c
--- a/src/shards_vulkan_win32.c
+++ b/src/shards_vulkan_win32.c
@@ -0,0 +1,335 @@
+/*
+ * The Vulkan loader's entry points Venus calls directly, on Windows (shards, D202): each
+ * forwarded to the host's loader, vulkan-1.dll from System32, opened once, at the first
+ * call, with every entry point found then, as virglrenderer opens libvulkan on Linux
+ * (vulkan-dload). Nothing links the loader, so the GPU's VM process starts where none is
+ * installed, and says so (crates/vmm, virgl.rs).
+ */
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+#include "venus-protocol/vulkan.h"
+
+static struct {
+   PFN_vkAllocateMemory AllocateMemory;
+   PFN_vkCreateDevice CreateDevice;
+   PFN_vkCreateInstance CreateInstance;
+   PFN_vkDestroyDevice DestroyDevice;
+   PFN_vkDestroyInstance DestroyInstance;
+   PFN_vkEnumerateDeviceExtensionProperties EnumerateDeviceExtensionProperties;
+   PFN_vkEnumerateInstanceVersion EnumerateInstanceVersion;
+   PFN_vkEnumeratePhysicalDeviceGroups EnumeratePhysicalDeviceGroups;
+   PFN_vkEnumeratePhysicalDevices EnumeratePhysicalDevices;
+   PFN_vkFreeMemory FreeMemory;
+   PFN_vkGetDeviceProcAddr GetDeviceProcAddr;
+   PFN_vkGetInstanceProcAddr GetInstanceProcAddr;
+   PFN_vkGetPhysicalDeviceExternalBufferProperties GetPhysicalDeviceExternalBufferProperties;
+   PFN_vkGetPhysicalDeviceExternalFenceProperties GetPhysicalDeviceExternalFenceProperties;
+   PFN_vkGetPhysicalDeviceExternalSemaphoreProperties GetPhysicalDeviceExternalSemaphoreProperties;
+   PFN_vkGetPhysicalDeviceFeatures GetPhysicalDeviceFeatures;
+   PFN_vkGetPhysicalDeviceFeatures2 GetPhysicalDeviceFeatures2;
+   PFN_vkGetPhysicalDeviceFormatProperties GetPhysicalDeviceFormatProperties;
+   PFN_vkGetPhysicalDeviceFormatProperties2 GetPhysicalDeviceFormatProperties2;
+   PFN_vkGetPhysicalDeviceImageFormatProperties GetPhysicalDeviceImageFormatProperties;
+   PFN_vkGetPhysicalDeviceImageFormatProperties2 GetPhysicalDeviceImageFormatProperties2;
+   PFN_vkGetPhysicalDeviceMemoryProperties GetPhysicalDeviceMemoryProperties;
+   PFN_vkGetPhysicalDeviceMemoryProperties2 GetPhysicalDeviceMemoryProperties2;
+   PFN_vkGetPhysicalDeviceProperties GetPhysicalDeviceProperties;
+   PFN_vkGetPhysicalDeviceProperties2 GetPhysicalDeviceProperties2;
+   PFN_vkGetPhysicalDeviceQueueFamilyProperties GetPhysicalDeviceQueueFamilyProperties;
+   PFN_vkGetPhysicalDeviceQueueFamilyProperties2 GetPhysicalDeviceQueueFamilyProperties2;
+   PFN_vkGetPhysicalDeviceSparseImageFormatProperties GetPhysicalDeviceSparseImageFormatProperties;
+   PFN_vkGetPhysicalDeviceSparseImageFormatProperties2 GetPhysicalDeviceSparseImageFormatProperties2;
+   PFN_vkMapMemory MapMemory;
+   PFN_vkUnmapMemory UnmapMemory;
+} shards_vk;
+
+static BOOL CALLBACK
+shards_vulkan_open(PINIT_ONCE once, PVOID param, PVOID *context)
+{
+   (void)once;
+   (void)param;
+   (void)context;
+   HMODULE loader = LoadLibraryExW(L"vulkan-1.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+   if (!loader)
+      return TRUE;
+   shards_vk.AllocateMemory = (PFN_vkAllocateMemory)(void (*)(void))GetProcAddress(loader, "vkAllocateMemory");
+   shards_vk.CreateDevice = (PFN_vkCreateDevice)(void (*)(void))GetProcAddress(loader, "vkCreateDevice");
+   shards_vk.CreateInstance = (PFN_vkCreateInstance)(void (*)(void))GetProcAddress(loader, "vkCreateInstance");
+   shards_vk.DestroyDevice = (PFN_vkDestroyDevice)(void (*)(void))GetProcAddress(loader, "vkDestroyDevice");
+   shards_vk.DestroyInstance = (PFN_vkDestroyInstance)(void (*)(void))GetProcAddress(loader, "vkDestroyInstance");
+   shards_vk.EnumerateDeviceExtensionProperties = (PFN_vkEnumerateDeviceExtensionProperties)(void (*)(void))GetProcAddress(loader, "vkEnumerateDeviceExtensionProperties");
+   shards_vk.EnumerateInstanceVersion = (PFN_vkEnumerateInstanceVersion)(void (*)(void))GetProcAddress(loader, "vkEnumerateInstanceVersion");
+   shards_vk.EnumeratePhysicalDeviceGroups = (PFN_vkEnumeratePhysicalDeviceGroups)(void (*)(void))GetProcAddress(loader, "vkEnumeratePhysicalDeviceGroups");
+   shards_vk.EnumeratePhysicalDevices = (PFN_vkEnumeratePhysicalDevices)(void (*)(void))GetProcAddress(loader, "vkEnumeratePhysicalDevices");
+   shards_vk.FreeMemory = (PFN_vkFreeMemory)(void (*)(void))GetProcAddress(loader, "vkFreeMemory");
+   shards_vk.GetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)(void (*)(void))GetProcAddress(loader, "vkGetDeviceProcAddr");
+   shards_vk.GetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)(void (*)(void))GetProcAddress(loader, "vkGetInstanceProcAddr");
+   shards_vk.GetPhysicalDeviceExternalBufferProperties = (PFN_vkGetPhysicalDeviceExternalBufferProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceExternalBufferProperties");
+   shards_vk.GetPhysicalDeviceExternalFenceProperties = (PFN_vkGetPhysicalDeviceExternalFenceProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceExternalFenceProperties");
+   shards_vk.GetPhysicalDeviceExternalSemaphoreProperties = (PFN_vkGetPhysicalDeviceExternalSemaphoreProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceExternalSemaphoreProperties");
+   shards_vk.GetPhysicalDeviceFeatures = (PFN_vkGetPhysicalDeviceFeatures)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceFeatures");
+   shards_vk.GetPhysicalDeviceFeatures2 = (PFN_vkGetPhysicalDeviceFeatures2)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceFeatures2");
+   shards_vk.GetPhysicalDeviceFormatProperties = (PFN_vkGetPhysicalDeviceFormatProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceFormatProperties");
+   shards_vk.GetPhysicalDeviceFormatProperties2 = (PFN_vkGetPhysicalDeviceFormatProperties2)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceFormatProperties2");
+   shards_vk.GetPhysicalDeviceImageFormatProperties = (PFN_vkGetPhysicalDeviceImageFormatProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceImageFormatProperties");
+   shards_vk.GetPhysicalDeviceImageFormatProperties2 = (PFN_vkGetPhysicalDeviceImageFormatProperties2)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceImageFormatProperties2");
+   shards_vk.GetPhysicalDeviceMemoryProperties = (PFN_vkGetPhysicalDeviceMemoryProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceMemoryProperties");
+   shards_vk.GetPhysicalDeviceMemoryProperties2 = (PFN_vkGetPhysicalDeviceMemoryProperties2)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceMemoryProperties2");
+   shards_vk.GetPhysicalDeviceProperties = (PFN_vkGetPhysicalDeviceProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceProperties");
+   shards_vk.GetPhysicalDeviceProperties2 = (PFN_vkGetPhysicalDeviceProperties2)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceProperties2");
+   shards_vk.GetPhysicalDeviceQueueFamilyProperties = (PFN_vkGetPhysicalDeviceQueueFamilyProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceQueueFamilyProperties");
+   shards_vk.GetPhysicalDeviceQueueFamilyProperties2 = (PFN_vkGetPhysicalDeviceQueueFamilyProperties2)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceQueueFamilyProperties2");
+   shards_vk.GetPhysicalDeviceSparseImageFormatProperties = (PFN_vkGetPhysicalDeviceSparseImageFormatProperties)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceSparseImageFormatProperties");
+   shards_vk.GetPhysicalDeviceSparseImageFormatProperties2 = (PFN_vkGetPhysicalDeviceSparseImageFormatProperties2)(void (*)(void))GetProcAddress(loader, "vkGetPhysicalDeviceSparseImageFormatProperties2");
+   shards_vk.MapMemory = (PFN_vkMapMemory)(void (*)(void))GetProcAddress(loader, "vkMapMemory");
+   shards_vk.UnmapMemory = (PFN_vkUnmapMemory)(void (*)(void))GetProcAddress(loader, "vkUnmapMemory");
+   return TRUE;
+}
+
+/* The entry points, found once; each null where the host has no loader, or its loader
+ * none of that name. */
+static void
+shards_vulkan(void)
+{
+   static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+   InitOnceExecuteOnce(&once, shards_vulkan_open, NULL, NULL);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vkAllocateMemory(VkDevice device, const VkMemoryAllocateInfo* pAllocateInfo, const VkAllocationCallbacks* pAllocator, VkDeviceMemory* pMemory)
+{
+   shards_vulkan();
+   return shards_vk.AllocateMemory ? shards_vk.AllocateMemory(device, pAllocateInfo, pAllocator, pMemory) : VK_ERROR_INITIALIZATION_FAILED;
+}
+
