diff --color -ruN pristine/virglrenderer-0.10.4e-krunkit/src/shards_win32.c src/virglrenderer-0.10.4e-krunkit/src/shards_win32.c
--- a/src/shards_win32.c
+++ b/src/shards_win32.c
@@ -0,0 +1,42 @@
+/*
+ * shards_win32.h's functions (shards, D202).
+ */
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+#include "shards_win32.h"
+
+int shards_clock_gettime(int clock, struct timespec *ts)
+{
+   if (clock == CLOCK_REALTIME)
+      return timespec_get(ts, TIME_UTC) == TIME_UTC ? 0 : -1;
+   /* The counter's frequency, fixed at boot (QueryPerformanceFrequency's documentation). */
+   LARGE_INTEGER frequency, now;
+   if (!QueryPerformanceFrequency(&frequency) || !QueryPerformanceCounter(&now))
+      return -1;
+   ts->tv_sec = (time_t)(now.QuadPart / frequency.QuadPart);
+   ts->tv_nsec = (long)((now.QuadPart % frequency.QuadPart) * 1000000000LL / frequency.QuadPart);
+   return 0;
+}
+
+int shards_nanosleep(const struct timespec *req, struct timespec *rem)
+{
+   if (rem) {
+      rem->tv_sec = 0;
+      rem->tv_nsec = 0;
+   }
+   HANDLE timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+   if (!timer) {
+      Sleep((DWORD)(req->tv_sec * 1000 + req->tv_nsec / 1000000));
+      return 0;
+   }
+   /* Relative, in 100 ns units. */
+   LARGE_INTEGER due;
+   due.QuadPart = -((LONGLONG)req->tv_sec * 10000000LL + req->tv_nsec / 100);
+   if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+      WaitForSingleObject(timer, INFINITE);
+   CloseHandle(timer);
+   return 0;
+}
