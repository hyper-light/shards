+/*
+ * The POSIX names virglrenderer's in-process Venus uses, on Windows (shards, D202):
+ * included before every source of its build there (meson.build), as its config.h is.
+ */
+#ifndef SHARDS_WIN32_H
+#define SHARDS_WIN32_H
+#ifdef _WIN32
+#include <basetsd.h>
+#include <io.h>
+#include <process.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+typedef SSIZE_T ssize_t;
+#define strtok_r strtok_s
+
+/* The UCRT's ISO names for the POSIX functions the sources call, whose POSIX names it
+ * deprecates: function-like, after the CRT's own declarations, which keep theirs. */
+#define close(fd) _close(fd)
+#define read(fd, buf, n) _read(fd, buf, n)
+#define write(fd, buf, n) _write(fd, buf, n)
+#define lseek(fd, offset, whence) _lseek(fd, offset, whence)
+#define strdup(s) _strdup(s)
+#define getpid() _getpid()
+#define dup(fd) _dup(fd)
+
+#ifndef CLOCK_REALTIME
+#define CLOCK_REALTIME 0
+#endif
+#ifndef CLOCK_MONOTONIC
+#define CLOCK_MONOTONIC 1
+#endif
+
+/* clock_gettime: CLOCK_MONOTONIC by the performance counter; CLOCK_REALTIME as
+ * timespec_get(TIME_UTC) says it, the clock C11's cnd_timedwait reads (threads_win32.h). */
+int shards_clock_gettime(int clock, struct timespec *ts);
+/* nanosleep by a high-resolution waitable timer, which wakes within the period asked rather
+ * than at the system timer's next tick (15.6 ms by default). */
+int shards_nanosleep(const struct timespec *req, struct timespec *rem);
+#define clock_gettime shards_clock_gettime
+#define nanosleep shards_nanosleep
+#endif
+#endif
