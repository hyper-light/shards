diff --git a/src/venus/vkr_physical_device_filter.h b/src/venus/vkr_physical_device_filter.h
new file mode 100644
--- /dev/null
+++ b/src/venus/vkr_physical_device_filter.h
@@ -0,0 +1,247 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef VKR_PHYSICAL_DEVICE_FILTER_H
+#define VKR_PHYSICAL_DEVICE_FILTER_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Vulkan deviceUUID is VK_UUID_SIZE (16) opaque bytes. The host selector uses
+ * two hex digits per byte; its list fits the caller's u16 device-index space.
+ */
+#define VKR_PHYSICAL_DEVICE_FILTER_MAX_COUNT (UINT32_C(1) + UINT16_MAX)
+
+enum vkr_physical_device_filter_state {
+   VKR_PHYSICAL_DEVICE_FILTER_UNSET,
+   VKR_PHYSICAL_DEVICE_FILTER_INVALID,
+   VKR_PHYSICAL_DEVICE_FILTER_SELECTED,
+};
+
+struct vkr_physical_device_uuid {
+   uint8_t bytes[VK_UUID_SIZE];
+};
+
+struct vkr_physical_device_filter {
+   enum vkr_physical_device_filter_state state;
+   uint32_t count;
+   struct vkr_physical_device_uuid *uuids;
+};
+
+static inline void
+vkr_physical_device_filter_finish(struct vkr_physical_device_filter *filter)
+{
+   free(filter->uuids);
+   filter->uuids = NULL;
+   filter->count = 0;
+   filter->state = VKR_PHYSICAL_DEVICE_FILTER_INVALID;
+}
+
+static inline int
+vkr_physical_device_uuid_compare(const void *a, const void *b)
+{
+   return memcmp(a, b, sizeof(struct vkr_physical_device_uuid));
+}
+
+static inline int
+vkr_physical_device_hex_digit(char digit)
+{
+   if (digit >= '0' && digit <= '9')
+      return digit - '0';
+   if (digit >= 'a' && digit <= 'f')
+      return digit - 'a' + 10;
+   if (digit >= 'A' && digit <= 'F')
+      return digit - 'A' + 10;
+   return -1;
+}
+
+static inline VkResult
+vkr_physical_device_filter_set(struct vkr_physical_device_filter *filter,
+                              const char *const *hex32,
+                              uint32_t count)
+{
+   const bool unset = filter->state == VKR_PHYSICAL_DEVICE_FILTER_UNSET;
+   /* A failed or repeated configuration can never fall back to all devices. */
+   vkr_physical_device_filter_finish(filter);
+   if (!unset || !hex32 || !count || count > VKR_PHYSICAL_DEVICE_FILTER_MAX_COUNT)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   if (sizeof(*filter->uuids) > SIZE_MAX / (size_t)count)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   struct vkr_physical_device_uuid *uuids = calloc(count, sizeof(*uuids));
+   if (!uuids)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   for (uint32_t i = 0; i < count; i++) {
+      const char *text = hex32[i];
+      if (!text)
+         goto invalid;
+      for (uint32_t j = 0; j < VK_UUID_SIZE; j++) {
+         const int high = vkr_physical_device_hex_digit(*text);
+         if (high < 0)
+            goto invalid;
+         text++;
+         const int low = vkr_physical_device_hex_digit(*text);
+         if (low < 0)
+            goto invalid;
+         text++;
+         uuids[i].bytes[j] = (uint8_t)((high << 4) | low);
+      }
+      if (*text)
+         goto invalid;
+   }
+
+   qsort(uuids, count, sizeof(*uuids), vkr_physical_device_uuid_compare);
+   for (uint32_t i = 1; i < count; i++) {
+      if (!vkr_physical_device_uuid_compare(&uuids[i - 1], &uuids[i]))
+         goto invalid;
+   }
+   filter->uuids = uuids;
+   filter->count = count;
+   filter->state = VKR_PHYSICAL_DEVICE_FILTER_SELECTED;
+   return VK_SUCCESS;
+
+invalid:
+   free(uuids);
+   return VK_ERROR_INITIALIZATION_FAILED;
+}
+
+static inline VkResult
+vkr_physical_device_filter_devices(const struct vkr_physical_device_filter *filter,
+                                  PFN_vkGetPhysicalDeviceProperties2 get_properties,
+                                  VkPhysicalDevice *handles,
+                                  uint32_t *count)
+{
+   if (filter->state != VKR_PHYSICAL_DEVICE_FILTER_SELECTED || !get_properties ||
+       *count > VKR_PHYSICAL_DEVICE_FILTER_MAX_COUNT)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   bool *found = calloc(filter->count, sizeof(*found));
+   if (!found)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   uint32_t kept = 0;
+   for (uint32_t i = 0; i < *count; i++) {
+      VkPhysicalDeviceIDProperties id = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES,
+      };
+      VkPhysicalDeviceProperties2 props = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+         .pNext = &id,
+      };
+      get_properties(handles[i], &props);
+      struct vkr_physical_device_uuid uuid;
+      memcpy(uuid.bytes, id.deviceUUID, sizeof(uuid.bytes));
+      const struct vkr_physical_device_uuid *selected =
+         bsearch(&uuid, filter->uuids, filter->count, sizeof(*filter->uuids),
+                 vkr_physical_device_uuid_compare);
+      if (!selected)
+         continue;
+      const size_t index = (size_t)(selected - filter->uuids);
+      /* One requested identity must resolve to exactly one host handle. */
+      if (found[index]) {
+         free(found);
+         return VK_ERROR_INITIALIZATION_FAILED;
+      }
+      found[index] = true;
+      handles[kept++] = handles[i];
+   }
+
+   free(found);
+   if (kept != filter->count)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   *count = kept;
+   return VK_SUCCESS;
+}
+
+struct vkr_physical_device_filter_handle {
+   uintptr_t value;
+   uint32_t index;
+   bool seen;
+};
+
+static inline int
+vkr_physical_device_filter_handle_compare(const void *a, const void *b)
+{
+   const struct vkr_physical_device_filter_handle *left = a, *right = b;
+   return (left->value > right->value) - (left->value < right->value);
+}
+
+static inline struct vkr_physical_device_filter_handle *
+vkr_physical_device_filter_find(struct vkr_physical_device_filter_handle *map,
+                              uint32_t count,
+                              VkPhysicalDevice handle)
+{
+   const struct vkr_physical_device_filter_handle key = { .value = (uintptr_t)handle };
+   return bsearch(&key, map, count, sizeof(*map),
+                  vkr_physical_device_filter_handle_compare);
+}
+
+static inline VkResult
+vkr_physical_device_filter_map(VkPhysicalDevice *handles,
+                              uint32_t count,
+                              struct vkr_physical_device_filter_handle **out)
+{
+   *out = NULL;
+   if (!count || count > VKR_PHYSICAL_DEVICE_FILTER_MAX_COUNT)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   if (sizeof(**out) > SIZE_MAX / (size_t)count)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   struct vkr_physical_device_filter_handle *map = calloc(count, sizeof(*map));
+   if (!map)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   for (uint32_t i = 0; i < count; i++) {
+      map[i].value = (uintptr_t)handles[i];
+      map[i].index = i;
+   }
+   qsort(map, count, sizeof(*map), vkr_physical_device_filter_handle_compare);
+   for (uint32_t i = 0; i < count; i++) {
+      if (!map[i].value || (i && map[i - 1].value == map[i].value)) {
+         free(map);
+         return VK_ERROR_INITIALIZATION_FAILED;
+      }
+   }
+   *out = map;
+   return VK_SUCCESS;
+}
+
+static inline VkResult
+vkr_physical_device_filter_groups(struct vkr_physical_device_filter_handle *map,
+                                 uint32_t device_count,
+                                 VkPhysicalDeviceGroupProperties *groups,
+                                 uint32_t *group_count)
+{
+   uint32_t kept = 0;
+   for (uint32_t i = 0; i < *group_count; i++) {
+      VkPhysicalDeviceGroupProperties *group = &groups[i];
+      if (!group->physicalDeviceCount || group->physicalDeviceCount > VK_MAX_DEVICE_GROUP_SIZE)
+         return VK_ERROR_INITIALIZATION_FAILED;
+      uint32_t selected = 0;
+      for (uint32_t j = 0; j < group->physicalDeviceCount; j++) {
+         struct vkr_physical_device_filter_handle *entry =
+            vkr_physical_device_filter_find(map, device_count, group->physicalDevices[j]);
+         if (!entry)
+            continue;
+         /* Vulkan groups partition the enumerated devices. Refuse an ambiguous
+          * driver response instead of fabricating a group or leaking an alias.
+          */
+         if (entry->seen)
+            return VK_ERROR_INITIALIZATION_FAILED;
+         entry->seen = true;
+         selected++;
+      }
+      if (!selected)
+         continue;
+      if (selected != group->physicalDeviceCount)
+         return VK_ERROR_INITIALIZATION_FAILED;
+      groups[kept++] = *group;
+   }
+   for (uint32_t i = 0; i < device_count; i++) {
+      if (!map[i].seen)
+         return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   *group_count = kept;
+   return VK_SUCCESS;
+}
+
+#endif
