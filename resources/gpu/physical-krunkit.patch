+/* The selected path stages and validates the complete driver answer before any
+ * guest count or output write. A mixed group cannot be split into a fake group.
+ */
+static VkResult
+vkr_instance_enumerate_selected_groups(
+   struct vkr_instance *instance,
+   struct vn_command_vkEnumeratePhysicalDeviceGroups *args)
+{
+   VkPhysicalDeviceGroupProperties *groups = NULL;
+   struct vkr_physical_device_filter_handle *map = NULL;
+   const uint32_t capacity = *args->pPhysicalDeviceGroupCount;
+   *args->pPhysicalDeviceGroupCount = 0;
+
+   uint32_t count = 0;
+   VkResult result = vkEnumeratePhysicalDeviceGroups(instance->base.handle.instance, &count, NULL);
+   if (result != VK_SUCCESS)
+      return result;
+   if (!count || count > VKR_PHYSICAL_DEVICE_FILTER_MAX_COUNT)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   if (sizeof(*groups) > SIZE_MAX / (size_t)count)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   groups = calloc(count, sizeof(*groups));
+   if (!groups)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   for (uint32_t i = 0; i < count; i++)
+      groups[i].sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_GROUP_PROPERTIES;
+
+   const uint32_t host_capacity = count;
+   result = vkEnumeratePhysicalDeviceGroups(instance->base.handle.instance, &count, groups);
+   if (result != VK_SUCCESS)
+      goto out;
+   if (count > host_capacity) {
+      result = VK_ERROR_INITIALIZATION_FAILED;
+      goto out;
+   }
+   result = vkr_physical_device_filter_map(instance->physical_device_handles,
+                                            instance->physical_device_count, &map);
+   if (result != VK_SUCCESS)
+      goto out;
+   result = vkr_physical_device_filter_groups(map, instance->physical_device_count,
+                                               groups, &count);
+   if (result != VK_SUCCESS)
+      goto out;
+
+   if (!args->pPhysicalDeviceGroupProperties) {
+      *args->pPhysicalDeviceGroupCount = count;
+      goto out;
+   }
+
+   const uint32_t written = MIN2(capacity, count);
+   /* Existing Venus requires object ids from EnumeratePhysicalDevices first.
+    * Resolve every output member before modifying any guest output.
+    */
+   for (uint32_t i = 0; i < written; i++) {
+      for (uint32_t j = 0; j < groups[i].physicalDeviceCount; j++) {
+         const struct vkr_physical_device_filter_handle *entry =
+            vkr_physical_device_filter_find(map, instance->physical_device_count,
+                                             groups[i].physicalDevices[j]);
+         if (!entry || !instance->physical_devices[entry->index]) {
+            result = VK_ERROR_INITIALIZATION_FAILED;
+            goto out;
+         }
+         const struct vkr_physical_device *physical_dev =
+            instance->physical_devices[entry->index];
+         vkr_cs_handle_store_id((void **)&groups[i].physicalDevices[j], physical_dev->base.id,
+                                VK_OBJECT_TYPE_PHYSICAL_DEVICE);
+      }
+   }
+   for (uint32_t i = 0; i < written; i++) {
+      VkPhysicalDeviceGroupProperties *output = &args->pPhysicalDeviceGroupProperties[i];
+      output->physicalDeviceCount = groups[i].physicalDeviceCount;
+      output->subsetAllocation = groups[i].subsetAllocation;
+      memcpy(output->physicalDevices, groups[i].physicalDevices,
+             groups[i].physicalDeviceCount * sizeof(*output->physicalDevices));
+   }
+   *args->pPhysicalDeviceGroupCount = written;
+   result = written < count ? VK_INCOMPLETE : VK_SUCCESS;
+
+out:
+   free(map);
+   free(groups);
+   return result;
+}
