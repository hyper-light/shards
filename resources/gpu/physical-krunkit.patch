+int32_t
+vkr_renderer_set_physical_device_uuids(uint32_t ctx_id,
+                                      const char *const *hex32,
+                                      uint32_t count)
+{
+   struct vkr_context *ctx = vkr_renderer_lookup_context(ctx_id);
+   if (!ctx)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   if (ctx->instance) {
+      vkr_physical_device_filter_finish(&ctx->physical_device_filter);
+      vkr_context_set_fatal(ctx);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   return vkr_physical_device_filter_set(&ctx->physical_device_filter, hex32, count);
+}
+
