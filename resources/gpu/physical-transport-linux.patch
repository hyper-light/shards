+      /* Each context implementation poisons or closes its owned context. */
+      ctx->set_physical_device_uuids(ctx, NULL, 0);
+      return VIRGL_RENDERER_UUIDS_INITIALIZATION_FAILED;
+   }
+   ctx->device_selection_state = VIRGL_DEVICE_SELECTION_INVALID;
+   const int32_t result = ctx->set_physical_device_uuids(ctx, hex32, count);
+   if (result == VIRGL_RENDERER_UUIDS_SUCCESS)
+      ctx->device_selection_state = VIRGL_DEVICE_SELECTION_SELECTED;
+   return result;
+}
