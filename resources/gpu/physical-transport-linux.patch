diff --git a/src/virgl_device_selection.h b/src/virgl_device_selection.h
new file mode 100644
--- /dev/null
+++ b/src/virgl_device_selection.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef VIRGL_DEVICE_SELECTION_H
+#define VIRGL_DEVICE_SELECTION_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Vulkan VK_UUID_SIZE is 16. The host API encodes each byte as two hex digits
+ * plus a NUL terminator; selection fits the caller's full u16 index space.
+ */
+#define VIRGL_DEVICE_UUID_SIZE 16u
+#define VIRGL_DEVICE_UUID_STRIDE (VIRGL_DEVICE_UUID_SIZE * 2u + 1u)
+#define VIRGL_DEVICE_UUID_MAX_COUNT (UINT32_C(1) + UINT16_MAX)
+
+enum virgl_device_selection_state {
+   VIRGL_DEVICE_SELECTION_NEW,
+   VIRGL_DEVICE_SELECTION_READY,
+   VIRGL_DEVICE_SELECTION_SELECTED,
+   VIRGL_DEVICE_SELECTION_STARTED,
+   VIRGL_DEVICE_SELECTION_INVALID,
+};
+
+static inline bool
+virgl_device_selection_payload_size(uint32_t count, size_t *size)
+{
+   if (!count || count > VIRGL_DEVICE_UUID_MAX_COUNT ||
+       count > UINT32_MAX / VIRGL_DEVICE_UUID_STRIDE ||
+       VIRGL_DEVICE_UUID_STRIDE > SIZE_MAX / (size_t)count)
+      return false;
+   *size = (size_t)count * VIRGL_DEVICE_UUID_STRIDE;
+   return true;
+}
+
+static inline bool
+virgl_device_selection_copy_hex(char *output, const char *input)
+{
+   if (!input)
+      return false;
+   for (size_t i = 0; i < VIRGL_DEVICE_UUID_STRIDE - 1; i++) {
+      const char digit = *input;
+      if (!((digit >= '0' && digit <= '9') || (digit >= 'a' && digit <= 'f') ||
+            (digit >= 'A' && digit <= 'F')))
+         return false;
+      output[i] = digit;
+      input++;
+   }
+   if (*input)
+      return false;
+   output[VIRGL_DEVICE_UUID_STRIDE - 1] = '\0';
+   return true;
+}
+
+#endif
