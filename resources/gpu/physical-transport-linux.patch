+      goto out;
+   payload = calloc(1, size);
+   if (!payload) {
+      result = VIRGL_RENDERER_UUIDS_OUT_OF_HOST_MEMORY;
+      goto out;
+   }
+   for (uint32_t i = 0; i < count; i++) {
+      if (!virgl_device_selection_copy_hex(payload + (size_t)i * VIRGL_DEVICE_UUID_STRIDE,
+                                             hex32[i]))
+         goto out;
+   }
+   const struct render_context_op_set_uuids_request request = {
+      .header.op = RENDER_CONTEXT_OP_SET_UUIDS,
+      .count = count,
+      .byte_count = (uint32_t)size,
+   };
+   if (!proxy_socket_send_request(&ctx->socket, &request, sizeof(request)))
+      goto out;
+   /* Reuse the existing protocol's inline command payload bound. Each frame
+    * is received with an exact length; no new chunk/wait/retry default.
+    */
+   for (size_t offset = 0; offset < size;) {
+      const size_t chunk = MIN2(size - offset,
+         sizeof(((struct render_context_op_submit_cmd_request *)0)->cmd));
+      if (!proxy_socket_send_request(&ctx->socket, payload + offset, chunk))
+         goto out;
+      offset += chunk;
+   }
+   struct render_context_op_set_uuids_reply reply;
+   if (!proxy_socket_receive_reply(&ctx->socket, &reply, sizeof(reply)))
+      goto out;
+   if (reply.op != RENDER_CONTEXT_OP_SET_UUIDS)
+      goto out;
+   switch (reply.result) {
+   case VIRGL_RENDERER_UUIDS_SUCCESS:
+      if (reply.count != count)
+         goto out;
+      result = reply.result;
+      break;
+   case VIRGL_RENDERER_UUIDS_INITIALIZATION_FAILED:
+   case VIRGL_RENDERER_UUIDS_OUT_OF_HOST_MEMORY:
+      if (!reply.count)
+         result = reply.result;
+      break;
+   default:
+      break;
+   }
+
