+proxy_context_set_physical_device_uuids(struct virgl_context *base,
+                                       const char *const *hex32,
+                                       uint32_t count)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   int32_t result = VIRGL_RENDERER_UUIDS_INITIALIZATION_FAILED;
+   char *payload = NULL;
+   size_t size;
