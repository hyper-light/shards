# shards' changes to Firecracker's 6.18 microVM configs (firecracker-<arch>-6.18.config),
# merged by scripts/build-kernel.sh. The build fails if any line here does not survive
# `make olddefconfig`.

# Images are EROFS, delivered on virtio-pmem and mounted with DAX
# (docs/research/image-storage.md R1-R2). Uncompressed, so no decompressors (R1).
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
# CONFIG_EROFS_FS_ZIP is not set

# The guest reaches the VMM's control page (shards_abi::CONTROL_PAGE) through /dev/mem.
# STRICT_DEVMEM keeps RAM out of reach; the control page is MMIO. Firecracker's CI kernels
# get the same from its ci.config.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y

# Volumes, bind-mounted host directories and named volumes alike, are host directories the
# VM process serves over virtio-fs (D38), as Docker Desktop shares a host's: the FUSE
# protocol on virtio queues (Documentation/filesystems/virtiofs.rst), with DAX, so that the
# guest maps a file's pages from the device's shared window rather than copying them.
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_DAX=y

# IPv6 for agents' networks (D99): init's switch filters each agent's IPv6 flows with
# nf_tables' ip6 family as it filters IPv4's with ip's, and keeps strict reverse-path
# filtering, which IPv4 gets from the rp_filter sysctl and IPv6 has no sysctl for, with
# nf_tables' fib expression (nft(8), "FIB EXPRESSIONS"; RFC 3704 §2.2).
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_FIB_IPV6=y

# BPF programs compiled to native code, and no interpreter beside them (D215). Every
# workload's seccomp filter (D42) runs on its syscalls and the run's device filter (D44) on
# each device it opens; Firecracker's configs leave BPF_JIT unset, so both ran interpreted,
# though each architecture says it wants the JIT (ARCH_WANT_DEFAULT_BPF_JIT=y; x86 and
# arm64 select HAVE_EBPF_JIT). kernel/bpf/Kconfig: BPF_JIT "allows the kernel to generate
# native code when a program is loaded into the kernel. This will significantly speed-up
# processing of BPF programs"; BPF_JIT_ALWAYS_ON "Enables BPF JIT and removes BPF
# interpreter to avoid speculative execution of BPF instructions by the interpreter"
# (commit 290af86629b2: the interpreter was the gadget of CVE-2017-5715's attack from a
# guest). It needs BPF_SYSCALL, HAVE_EBPF_JIT and BPF_JIT, all here, and it makes a
# program the JIT cannot compile fail to load (bpf_prog_select_runtime: -ENOTSUPP) where it
# would have run interpreted. net.core.bpf_jit_harden stays 0, its default (no constant
# blinding). Measured in PM M462.
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# Ours, not Amazon's.
CONFIG_BUILD_SALT="shards"
