# The `kvm` variant (scripts/build-kernel.sh ARCH OUT kvm): KVM, for a guest that is
# itself a KVM host, booted at EL2 (`run --kernel --nested`, D132). Not in the kernel every
# other guest boots: KVM's 800 KiB of text would be in each, for no boot or restore time
# saved or spent (PM M192).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
