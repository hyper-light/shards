--- a/mm/page_reporting.c
+++ b/mm/page_reporting.c
@@ -48,6 +48,34 @@
 EXPORT_SYMBOL_GPL(page_reporting_order);
 
 #define PAGE_REPORTING_DELAY	(2 * HZ)
+
+/*
+ * The free pages a pass holds off the free lists until the device has reported
+ * them: free memory still, which sysinfo(2) and /proc/meminfo count as free
+ * (si_meminfo(), si_mem_available()), where the allocator's watermarks see them
+ * gone until they are back.
+ */
+static atomic_long_t page_reporting_held = ATOMIC_LONG_INIT(0);
+
+unsigned long page_reporting_held_pages(void)
+{
+	long held = atomic_long_read(&page_reporting_held);
+
+	return held > 0 ? held : 0;
+}
+
+static int page_reporting_held_get(char *buffer, const struct kernel_param *kp)
+{
+	return scnprintf(buffer, PAGE_SIZE, "%lu\n", page_reporting_held_pages());
+}
+
+static const struct kernel_param_ops page_reporting_held_ops = {
+	.get = &page_reporting_held_get,
+};
+
+module_param_cb(held, &page_reporting_held_ops, NULL, 0444);
+MODULE_PARM_DESC(held, "Free pages a pass holds until the device has reported them");
+
 static struct page_reporting_dev_info __rcu *pr_dev_info __read_mostly;
 
 enum {
