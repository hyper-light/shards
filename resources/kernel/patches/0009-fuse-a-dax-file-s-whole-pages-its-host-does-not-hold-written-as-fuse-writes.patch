+/*
+ * shards: maps each range of [@pos, @end) of @inode's file that the window maps none of,
+ * or maps to be read alone, to be written, as a store through the window would map it
+ * first (fuse_iomap_begin, which upgrades a mapping read alone), so that the device
+ * records which of its pages its host holds as the write comes, those its host read
+ * around a read's faults since among them, before the write is split by them. One that
+ * cannot be mapped counts as not held: the record is advice alone.
+ */
+static void fuse_dax_map_ranges(struct inode *inode, loff_t pos, loff_t end)
+{
+	struct fuse_inode *fi = get_fuse_inode(inode);
+
+	for (pos = round_down(pos, FUSE_DAX_SZ); pos < end; pos += FUSE_DAX_SZ) {
+		unsigned long idx = pos >> FUSE_DAX_SHIFT;
+		struct interval_tree_node *node;
+		struct iomap iomap = {}, srcmap = {};
+		bool writable;
+
+		down_read(&fi->dax->sem);
+		node = interval_tree_iter_first(&fi->dax->tree, idx, idx);
+		writable = node && node_to_dmap(node)->writable;
+		up_read(&fi->dax->sem);
+		if (writable)
+			continue;
+		if (!fuse_iomap_begin(inode, pos, PAGE_SIZE, IOMAP_WRITE, &iomap, &srcmap))
+			fuse_iomap_end(inode, pos, PAGE_SIZE, 0, IOMAP_WRITE, &iomap);
+	}
+}
+
+/*
+ * shards: writes @from run by run where it is whole pages, each range it meets mapped
+ * first: the pages the host does not hold as FUSE_WRITEs, whose pwrite(2) of whole pages
+ * reads none of them, where a store through the window into each would wait for its host
+ * to read it first (shards' PM M283, M299); those it holds through the window. Each run is
+ * recorded held after. Anything else goes through the window whole, as before.
+ */
+static ssize_t fuse_dax_write_runs(struct kiocb *iocb, struct iov_iter *from)
+{
+	struct inode *inode = file_inode(iocb->ki_filp);
+	struct fuse_conn_dax *fcd = get_fuse_conn(inode)->dax;
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	ssize_t written = 0;
+
+	if (!fcd->held || !IS_ALIGNED(iocb->ki_pos, PAGE_SIZE) ||
+	    !IS_ALIGNED(iov_iter_count(from), PAGE_SIZE)) {
+		loff_t pos = iocb->ki_pos;
+		ssize_t ret = dax_iomap_rw(iocb, from, &fuse_iomap_ops);
+
+		if (ret > 0)
+			fuse_dax_mark_held(inode, pos, ret);
+		return ret;
+	}
+	fuse_dax_map_ranges(inode, iocb->ki_pos, iocb->ki_pos + iov_iter_count(from));
+	while (iov_iter_count(from)) {
+		size_t left = iov_iter_count(from);
+		loff_t pos = iocb->ki_pos, end = pos + left, run_end;
+		bool held;
+		ssize_t ret;
+
+		down_read(&fi->dax->sem);
+		held = fuse_dax_held_run(fcd, fi, pos, end, true) > pos;
+		run_end = fuse_dax_held_run(fcd, fi, pos, end, held);
+		up_read(&fi->dax->sem);
+
+		iov_iter_truncate(from, run_end - pos);
+		if (held)
+			ret = dax_iomap_rw(iocb, from, &fuse_iomap_ops);
+		else
+			ret = fuse_dax_direct_write(iocb, from);
+		if (ret <= 0) {
+			iov_iter_reexpand(from, left);
+			return written ? written : ret;
+		}
+		iov_iter_reexpand(from, left - ret);
+		if (!held)
+			fuse_dax_mark_held(inode, pos, ret);
+		written += ret;
+		if (ret < run_end - pos)
+			break;
+	}
+	return written;
+}
