+/*
+ * shards: the end of the run of whole pages from @pos, at most @end, that the host
+ * holds, where @held, or does not, by the device's record (fcd->held); a page no range
+ * of the window maps counts as not held. The caller holds fi->dax->sem.
+ */
+static loff_t fuse_dax_held_run(struct fuse_conn_dax *fcd, struct fuse_inode *fi,
+				loff_t pos, loff_t end, bool held)
+{
+	while (pos < end) {
+		unsigned long idx = pos >> FUSE_DAX_SHIFT;
+		loff_t range_end = min_t(loff_t, end, (loff_t)(idx + 1) << FUSE_DAX_SHIFT);
+		struct fuse_dax_mapping *dmap =
+			node_to_dmap(interval_tree_iter_first(&fi->dax->tree, idx, idx));
+
+		for (; pos < range_end; pos += PAGE_SIZE) {
+			bool is_held = false;
+
+			if (dmap) {
+				u64 page = (dmap->window_offset + pos -
+					    ((loff_t)dmap->itn.start << FUSE_DAX_SHIFT)) >> PAGE_SHIFT;
+
+				is_held = page < fcd->held_pages && test_bit(page, fcd->held);
+			}
+			if (is_held != held)
+				return pos;
+		}
+	}
+	return end;
+}
+
+/*
+ * shards: records the pages of [@pos, @pos + @len) a range of the window maps as held by
+ * the host: written or read through the window, or written by a FUSE_WRITE, which the
+ * host's page cache now holds.
+ */
+static void fuse_dax_mark_held(struct inode *inode, loff_t pos, loff_t len)
+{
+	struct fuse_conn_dax *fcd = get_fuse_conn(inode)->dax;
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	loff_t end = pos + len;
+
+	if (!fcd->held || len <= 0)
+		return;
+	down_read(&fi->dax->sem);
+	for (pos = round_down(pos, PAGE_SIZE); pos < end;) {
+		unsigned long idx = pos >> FUSE_DAX_SHIFT;
+		loff_t range_end = min_t(loff_t, end, (loff_t)(idx + 1) << FUSE_DAX_SHIFT);
+		struct fuse_dax_mapping *dmap =
+			node_to_dmap(interval_tree_iter_first(&fi->dax->tree, idx, idx));
+
+		for (; pos < range_end; pos += PAGE_SIZE) {
+			u64 page;
+
+			if (!dmap)
+				continue;
+			page = (dmap->window_offset + pos -
+				((loff_t)dmap->itn.start << FUSE_DAX_SHIFT)) >> PAGE_SHIFT;
+			if (page < fcd->held_pages)
+				set_bit(page, fcd->held);
+		}
+	}
+	up_read(&fi->dax->sem);
+}
