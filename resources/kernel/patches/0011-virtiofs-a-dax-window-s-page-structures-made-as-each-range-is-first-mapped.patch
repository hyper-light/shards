@@ -194,6 +201,37 @@ static void dmap_add_to_free_pool(struct fuse_conn_dax *fcd,
 	spin_unlock(&fcd->lock);
 }
 
+/*
+ * shards: the page structures of @dmap's range, made the first time it is set up, where the
+ * window's pages leave them to it (PGMAP_LAZY_MEMMAP): before the range is in any inode's
+ * tree, so before a fault inserts any of its pages or a lookup finds their folios.
+ */
+static int fuse_dax_memmap_init(struct fuse_conn_dax *fcd,
+				struct fuse_dax_mapping *dmap)
+{
+	struct dev_pagemap *pgmap;
+	unsigned long pfn;
+	long nr;
+	int id;
+
+	if (dmap->memmap_ready)
+		return 0;
+	id = dax_read_lock();
+	nr = dax_direct_access(fcd->dev, PHYS_PFN(dmap->window_offset),
+			       FUSE_DAX_PAGES, DAX_ACCESS, NULL, &pfn);
+	dax_read_unlock(id);
+	if (nr < (long)FUSE_DAX_PAGES)
+		return nr < 0 ? nr : -EIO;
+	pgmap = get_dev_pagemap(pfn);
+	if (!pgmap)
+		return -EIO;
+	if (pgmap->flags & PGMAP_LAZY_MEMMAP)
+		memmap_init_device_range(pgmap, pfn, FUSE_DAX_PAGES);
+	put_dev_pagemap(pgmap);
+	dmap->memmap_ready = true;
+	return 0;
+}
+
