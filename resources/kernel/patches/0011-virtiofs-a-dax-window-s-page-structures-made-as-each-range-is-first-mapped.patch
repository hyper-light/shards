+
+/**
+ * memmap_init_device_range - initialize the structures of device pages left to their owner
+ * @pgmap: their pgmap, of base pages, with PGMAP_LAZY_MEMMAP
+ * @pfn: the first page
+ * @nr_pages: how many
+ *
+ * shards: what memmap_init_zone_device() does for each page, which a pgmap with
+ * PGMAP_LAZY_MEMMAP leaves to its owner, for a range it is about to hand out: before
+ * any of its pages is mapped, or its folio looked at.
+ */
+void memmap_init_device_range(struct dev_pagemap *pgmap, unsigned long pfn,
+			      unsigned long nr_pages)
+{
+	unsigned long end_pfn = pfn + nr_pages;
+
+	if (WARN_ON_ONCE(!(pgmap->flags & PGMAP_LAZY_MEMMAP)))
+		return;
+	for (; pfn < end_pfn; pfn++)
+		__init_zone_device_page(pfn_to_page(pfn), pfn, ZONE_DEVICE,
+					pgmap->nid, pgmap);
+}
+EXPORT_SYMBOL_GPL(memmap_init_device_range);
 #endif
 
