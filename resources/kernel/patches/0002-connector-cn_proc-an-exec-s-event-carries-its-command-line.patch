+}
+
+/*
+ * The most of an exec's command line its event carries: a page, as much as
+ * /proc/PID/cmdline gave before Linux 4.2.
+ */
+#define CN_PROC_EXEC_ARGS 4096
+
+/*
+ * Exec event @msg, followed by the command line the exec laid out: the
+ * arguments' whole length as a __u32, then as many of their bytes as
+ * CN_PROC_EXEC_ARGS holds, NUL-terminated as /proc/PID/cmdline gives them.
+ * A listener reading /proc/PID/cmdline instead races the process, which may
+ * have exited and been reaped by then. In a buffer to kfree(), NULL where
+ * there is no command line or no memory for it.
+ */
+static __u8 *exec_args(struct task_struct *task, struct cn_msg *msg)
+{
+	unsigned long start, end, len;
+	struct cn_msg *with;
+	__u8 *buffer;
+	__u32 whole;
+
+	if (task != current || !task->mm)
+		return NULL;
+	spin_lock(&task->mm->arg_lock);
+	start = task->mm->arg_start;
+	end = task->mm->arg_end;
+	spin_unlock(&task->mm->arg_lock);
+	if (end <= start)
+		return NULL;
+	len = min(end - start, (unsigned long)CN_PROC_EXEC_ARGS);
+	buffer = kmalloc(CN_PROC_MSG_SIZE + sizeof(whole) + len, GFP_KERNEL);
+	if (!buffer)
+		return NULL;
+	with = buffer_to_cn_msg(buffer);
+	memcpy(with, msg, sizeof(*msg) + msg->len);
+	whole = min(end - start, (unsigned long)U32_MAX);
+	memcpy(with->data + msg->len, &whole, sizeof(whole));
+	len -= copy_from_user(with->data + msg->len + sizeof(whole),
+			      (const void __user *)start, len);
+	with->len = msg->len + sizeof(whole) + len;
+	return buffer;
 }
 
