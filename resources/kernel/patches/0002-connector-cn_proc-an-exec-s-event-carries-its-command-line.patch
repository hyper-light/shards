@@ -149,6 +196,7 @@
 	struct cn_msg *msg;
 	struct proc_event *ev;
 	__u8 buffer[CN_PROC_MSG_SIZE] __aligned(8);
+	__u8 *args;
 
 	if (atomic_read(&proc_event_num_listeners) < 1)
 		return;
@@ -165,7 +213,11 @@
 	msg->ack = 0; /* not used */
 	msg->len = sizeof(*ev);
 	msg->flags = 0; /* not used */
-	send_msg(msg);
+	args = exec_args(task, msg);
+	/* Without its command line where there is no memory for it. */
+	if (!args || send_msg(buffer_to_cn_msg(args)) == -ENOMEM)
+		send_msg(msg);
+	kfree(args);
 }
 
