+
+/*
+ * The memory, in pages, the guest has once the host has plugged all it may
+ * (virtio-mem), as its own agent sets it through vm.pluggable_kbytes: what is
+ * still to be plugged is reported by sysinfo(2) and /proc/meminfo as total and
+ * free memory, so that what sizes itself by the memory it sees sizes itself by
+ * what it may have, not by what has been plugged so far. Nothing in the
+ * kernel's own accounting counts it.
+ */
+static unsigned long pluggable_ceiling;
+
+/* The memory still to be plugged, in pages, where the guest has @totalram. */
+unsigned long si_pluggable_pages(unsigned long totalram)
+{
+	unsigned long ceiling = READ_ONCE(pluggable_ceiling);
+
+	return ceiling > totalram ? ceiling - totalram : 0;
+}
+
+/*
+ * vm.pluggable_kbytes: read, the memory still to be plugged; written, the
+ * memory the host may plug from now on, which sets the ceiling.
+ */
+static int pluggable_kbytes_handler(const struct ctl_table *table, int write,
+				    void *buffer, size_t *lenp, loff_t *ppos)
+{
+	unsigned long totalram = totalram_pages();
+	unsigned long pages = si_pluggable_pages(totalram);
+	unsigned long kbytes;
+	struct ctl_table t = *table;
+	int ret;
 
+	kbytes = pages > ULONG_MAX >> (PAGE_SHIFT - 10) ?
+		 ULONG_MAX : pages << (PAGE_SHIFT - 10);
+	t.data = &kbytes;
+	ret = proc_doulongvec_minmax(&t, write, buffer, lenp, ppos);
+	if (ret || !write)
+		return ret;
+	pages = kbytes >> (PAGE_SHIFT - 10);
+	totalram = totalram_pages();
+	WRITE_ONCE(pluggable_ceiling, totalram + min(pages, ULONG_MAX - totalram));
+	return 0;
+}
+
+static const struct ctl_table pluggable_table[] = {
+	{
+		.procname	= "pluggable_kbytes",
+		.maxlen		= sizeof(unsigned long),
+		.mode		= 0644,
+		.proc_handler	= pluggable_kbytes_handler,
+	},
+};
+
+static int __init pluggable_sysctl_init(void)
+{
+	register_sysctl_init("vm", pluggable_table);
+	return 0;
+}
+subsys_initcall(pluggable_sysctl_init);
+
 void si_meminfo(struct sysinfo *val)
 {
 	val->totalram = totalram_pages();
