# shards' changes to the arm64 configuration alone, merged after shards.config.

# A tick of 1 ms where it was 10: a cold boot's PID 1, which loses the one vCPU to the
# crypto self-tests' kthreads in a third of boots and more under load, gets it back 1 ms
# later instead of 10 (PM M39, M65). Measured (PM M66): cold boots 26.2 -> 18.0 ms at the
# median; a busy vCPU +0.71% [+0.37%, +1.33%] host CPU; idle VMs, which do not tick
# (NO_HZ_IDLE), and restores unchanged. x86_64 keeps its 250, unmeasured here.
# CONFIG_HZ_100 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
