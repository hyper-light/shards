# shards' changes to the arm64 configuration alone, merged after shards.config.

# A tick of 1 ms where it was 10: a cold boot's PID 1, which loses the one vCPU to the
# crypto self-tests' kthreads in a third of boots and more under load, gets it back 1 ms
# later instead of 10 (PM M39, M65). Measured (PM M66): cold boots 26.2 -> 18.0 ms at the
# median; a busy vCPU +0.71% [+0.37%, +1.33%] host CPU; idle VMs, which do not tick
# (NO_HZ_IDLE), and restores unchanged. x86_64 keeps its 250, unmeasured here.
# CONFIG_HZ_100 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# As many CPUs as a machine has vCPUs at its most, 123 (crates/vmm layout::MAX_VCPUS: a
# GICv3 redistributor each in the memory map's room for them; D13), where Firecracker's 64
# left a guest of more vCPUs the first 64, and D191 gives a run one vCPU for each host CPU.
# Within arm64's range, 2 to 4096 (arch/arm64/Kconfig, NR_CPUS, Linux 6.18). Per-CPU areas
# are a possible CPU's, which the device tree's vCPUs alone are; what NR_CPUS adds of its
# own is unmeasured here (owed: the guest's overhead, PM M179, M183, on the kernel built
# with it). Held to layout::MAX_VCPUS by crates/vmm's
# `the_guest_kernel_takes_every_vcpu_a_machine_has`.
CONFIG_NR_CPUS=123
