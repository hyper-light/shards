# The toolchain that builds released kernels (scripts/build-kernel-in-builder.sh): a
# Debian image pinned by its multi-architecture index digest, with packages from Debian's
# snapshot archive at a fixed time, so the same inputs get the same compiler and linker.
# Both are part of a release's input hash (.github/workflows/kernel.yml).
BUILDER=docker.io/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
SNAPSHOT=20260915T000000Z
PACKAGES="bc bison build-essential ca-certificates curl flex libelf-dev libssl-dev patch xz-utils"
