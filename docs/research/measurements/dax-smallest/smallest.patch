@@ -1341,6 +1341,28 @@ pub fn started(link: &Link) {
 /// Where the VM holds a host's devices ([`HOST_DEVICES`]), the status goes with this
 /// process's pidfd, which its client waits on before it is done: the devices are free
 /// once this process has ended.
+/// This process's memory as its run ends, in KiB, for the DAX harness (measurement builds
+/// alone, docs/research/measurements/dax-smallest/smallest.patch): Linux's
+/// /proc/self/smaps_rollup Pss, macOS's phys_footprint; 0 where unknown.
+fn dax_memory_kib() -> u64 {
+    #[cfg(target_os = "linux")]
+    {
+        std::fs::read_to_string("/proc/self/smaps_rollup")
+            .ok()
+            .and_then(|s| {
+                let line = s.lines().find_map(|l| l.strip_prefix("Pss:"))?;
+                line.trim().strip_suffix("kB")?.trim().parse().ok()
+            })
+            .unwrap_or(0)
+    }
+    #[cfg(target_vendor = "apple")]
+    {
+        shards_ipc::footprint_kib()
+    }
+    #[cfg(not(any(target_os = "linux", target_vendor = "apple")))]
+    0
+}
