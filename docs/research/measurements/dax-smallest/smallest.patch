+/// What this process's windows map as its run ends (measurement builds alone,
+/// docs/research/measurements/dax-smallest/smallest.patch): ranges mapped now and at most,
+/// mappings and removals made.
+static RANGES_NOW: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static RANGES_PEAK: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static MAPS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static REMOVES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+/// The length of every window this process made, in bytes.
+static WINDOWS_LEN: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Logs, as this process's run ends, its windows' ranges mapped now and at most, the
+/// mappings and removals made, its host mappings (Linux: /proc/self/maps' lines; macOS:
+/// its regions, by mach_vm_region) and its open descriptors.
+pub fn log_end() {
+    use std::sync::atomic::Ordering::Relaxed;
+    crate::warn!(
+        "DAX-END windows_mib {} ranges {} peak {} maps {} removes {} host_mappings {} descriptors {}",
+        WINDOWS_LEN.load(Relaxed) >> 20,
+        RANGES_NOW.load(Relaxed),
+        RANGES_PEAK.load(Relaxed),
+        MAPS.load(Relaxed),
+        REMOVES.load(Relaxed),
+        host_mappings().map_or_else(|| "?".to_string(), |n| n.to_string()),
+        open_descriptors()
+    );
+}
+
+#[cfg(target_os = "linux")]
+fn host_mappings() -> Option<usize> {
+    std::fs::read_to_string("/proc/self/maps")
+        .ok()
+        .map(|m| m.lines().count())
+}
+
+#[cfg(target_os = "macos")]
+fn host_mappings() -> Option<usize> {
+    unsafe extern "C" {
+        /// This task's port, which the SDK's `mach_task_self()` reads (mach/mach_init.h).
+        static mach_task_self_: libc::mach_port_t;
+        fn mach_vm_region(
+            target_task: libc::vm_map_t,
+            address: *mut u64,
+            size: *mut u64,
+            flavor: i32,
+            info: *mut i32,
+            count: *mut u32,
+            object_name: *mut libc::mach_port_t,
+        ) -> libc::kern_return_t;
+    }
+    // VM_REGION_BASIC_INFO_64 and its count of words (mach/vm_region.h).
+    const BASIC_INFO_64: i32 = 9;
+    const BASIC_INFO_COUNT_64: u32 = 9;
+    let (mut at, mut n) = (0u64, 0usize);
+    loop {
+        let (mut size, mut info, mut count, mut object) = (0u64, [0i32; 16], BASIC_INFO_COUNT_64, 0);
+        // SAFETY: mach_vm_region(2) filling `info`, room for its flavor's words, for the
+        // region at or after `at` of this task.
+        let kr = unsafe {
+            mach_vm_region(
+                mach_task_self_,
+                &raw mut at,
+                &raw mut size,
+                BASIC_INFO_64,
+                info.as_mut_ptr(),
+                &raw mut count,
+                &raw mut object,
+            )
+        };
+        if kr != 0 {
+            return Some(n);
+        }
+        n += 1;
+        at = at.checked_add(size)?;
+    }
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "macos")))]
+fn host_mappings() -> Option<usize> {
+    None
+}
+
+/// Descriptors open in this process, by fcntl(2) of each below its limit.
+fn open_descriptors() -> usize {
+    // SAFETY: getdtablesize(3) and fcntl(F_GETFD) take nothing of this process's memory.
+    let most = unsafe { libc::getdtablesize() }.max(0);
+    (0..most)
+        // SAFETY: fcntl(F_GETFD) of a descriptor number, open or not.
+        .filter(|&fd| unsafe { libc::fcntl(fd, libc::F_GETFD) } != -1)
+        .count()
+}
