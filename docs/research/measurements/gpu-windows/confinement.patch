diff --git a/crates/vmm/src/devices/virtio/gpu/virgl.rs b/crates/vmm/src/devices/virtio/gpu/virgl.rs
index 25273641..20d2b797 100644
--- a/crates/vmm/src/devices/virtio/gpu/virgl.rs
+++ b/crates/vmm/src/devices/virtio/gpu/virgl.rs
@@ -680,9 +680,61 @@ impl std::fmt::Debug for Venus {
 
 static STARTED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
 
+/// M385: what of Windows' graphics this process reaches, said on stderr.
+#[cfg(windows)]
+fn m385_probe() {
+    use windows_sys::Win32::System::LibraryLoader::{GetProcAddress, LOAD_LIBRARY_SEARCH_SYSTEM32, LoadLibraryExW};
+    let say = |s: String| {
+        use std::io::Write as _;
+        let _ = writeln!(std::io::stderr(), "M385: {s}");
+    };
+    let load = |name: &str| {
+        let w: Vec<u16> = name.encode_utf16().chain([0]).collect();
+        // SAFETY: a system DLL by name.
+        let h = unsafe { LoadLibraryExW(w.as_ptr(), std::ptr::null_mut(), LOAD_LIBRARY_SEARCH_SYSTEM32) };
+        let e = std::io::Error::last_os_error();
+        say(format!("LoadLibrary {name}: {}", if h.is_null() { e.to_string() } else { "loaded".into() }));
+        h
+    };
+    let gdi = load("gdi32.dll");
+    if !gdi.is_null() {
+        #[repr(C)]
+        struct Enum2 {
+            count: u32,
+            adapters: *mut c_void,
+        }
+        // SAFETY: gdi32's export by name.
+        if let Some(f) = unsafe { GetProcAddress(gdi, c"D3DKMTEnumAdapters2".as_ptr().cast()) } {
+            // SAFETY: D3DKMTEnumAdapters2's signature (d3dkmthk.h).
+            let f: unsafe extern "system" fn(*mut Enum2) -> i32 = unsafe { std::mem::transmute(f) };
+            let mut e = Enum2 { count: 0, adapters: std::ptr::null_mut() };
+            // SAFETY: the count alone asked.
+            let st = unsafe { f(&raw mut e) };
+            say(format!("D3DKMTEnumAdapters2: status {st:#x}, {} adapters", e.count));
+        }
+    }
+    let _user = load("user32.dll");
+    let dxgi = load("dxgi.dll");
+    if !dxgi.is_null() {
+        // SAFETY: dxgi's export by name.
+        if let Some(f) = unsafe { GetProcAddress(dxgi, c"CreateDXGIFactory1".as_ptr().cast()) } {
+            // SAFETY: CreateDXGIFactory1's signature (dxgi.h).
+            let f: unsafe extern "system" fn(*const [u8; 16], *mut *mut c_void) -> i32 = unsafe { std::mem::transmute(f) };
+            // IID_IDXGIFactory1, 770aae78-f26f-4dba-a829-253c83d1b387.
+            let iid: [u8; 16] = [0x78, 0xae, 0x0a, 0x77, 0x6f, 0xf2, 0xba, 0x4d, 0xa8, 0x29, 0x25, 0x3c, 0x83, 0xd1, 0xb3, 0x87];
+            let mut out = std::ptr::null_mut();
+            // SAFETY: an IID and an out pointer.
+            let hr = unsafe { f(&raw const iid, &raw mut out) };
+            say(format!("CreateDXGIFactory1: hr {hr:#x}"));
+        }
+    }
+}
