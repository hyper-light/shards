 impl Venus {
     /// Starts the renderer, Venus alone: once a process.
     pub fn new() -> Result<Venus, String> {
+        #[cfg(windows)]
+        m385_probe();
         if STARTED.swap(true, std::sync::atomic::Ordering::AcqRel) {
             return Err("the GPU renderer runs once a process".into());
         }
