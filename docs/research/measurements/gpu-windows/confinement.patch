 /// Makes each window station's name its own within this process.
 static STATIONS: AtomicU64 = AtomicU64::new(0);
 
+/// M385: `n` window stations and desktops made for `container` and closed, each one's time.
+pub fn m385_stations(container: &AppContainer, n: usize) -> io::Result<Vec<std::time::Duration>> {
+    (0..n)
+        .map(|_| {
+            let at = std::time::Instant::now();
+            drop(Station::new(container)?);
+            Ok(at.elapsed())
+        })
+        .collect()
