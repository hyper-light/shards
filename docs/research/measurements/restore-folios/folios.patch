     let files = (|| -> io::Result<Vec<File>> {
         let memory_file = create_unsynced(&staged.staging.join(MEMORY), |f| memory.save(f))?;
+        // Experiment (docs/research/measurements/restore-folios): the file written back and
+        // its pages dropped from the page cache, which restores read again.
+        #[cfg(target_os = "linux")]
+        if std::env::var_os("SHARDS_SAVE_DROP").is_some_and(|v| v == "1") {
