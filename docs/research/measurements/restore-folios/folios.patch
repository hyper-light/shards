 pub fn child_env() -> Vec<(&'static str, std::ffi::OsString)> {
-    ["SHARDS_LOG", "SHARDS_TIMING"]
-        .into_iter()
+    // Experiment (docs/research/measurements/restore-folios): its switches reach the
+    // daemon and its VM processes.
+    [
+        "SHARDS_LOG",
+        "SHARDS_TIMING",
+        "SHARDS_RESTORE_RANDOM",
+        "SHARDS_SAVE_PAGEWISE",
+        "SHARDS_SAVE_DROP",
+        "SHARDS_WS_LOG",
+    ]
+    .into_iter()
         .filter_map(|name| std::env::var_os(name).map(|value| (name, value)))
         .collect()
 }
diff --git a/crates/vmm/src/memory.rs b/crates/vmm/src/memory.rs
index ff5db3b3..a41effe0 100644
--- a/crates/vmm/src/memory.rs
+++ b/crates/vmm/src/memory.rs
@@ -991,6 +991,13 @@ fn write_run(file: &File, r: &Region, run: Range<usize>, offset: u64) -> io::Res
     }
     let at = offset + run.start as u64;
     let mut done = 0;
+    // Experiment (docs/research/measurements/restore-folios): a page a write, so that the
+    // page cache holds the file in folios of a page.
+    let most = if std::env::var_os("SHARDS_SAVE_PAGEWISE").is_some_and(|v| v == "1") {
+        platform::page_size()?
+    } else {
+        usize::MAX
+    };
     while done < run.len() {
         // SAFETY: `run.start + done .. run.end` lies in the region (checked above); the
         // kernel reads it.
@@ -998,7 +1005,7 @@ fn write_run(file: &File, r: &Region, run: Range<usize>, offset: u64) -> io::Res
             platform::write_at(
                 file,
                 r.host.as_ptr().add(run.start + done),
-                run.len() - done,
+                (run.len() - done).min(most),
                 at + done as u64,
             )?
         };
diff --git a/crates/vmm/src/platform/unix.rs b/crates/vmm/src/platform/unix.rs
index 0a0cbfb8..5136e2b2 100644
--- a/crates/vmm/src/platform/unix.rs
+++ b/crates/vmm/src/platform/unix.rs
@@ -470,6 +470,12 @@ pub unsafe fn map_file_private(file: &File, offset: u64, len: usize, at: NonNull
     if p != at.as_ptr().cast() {
         return Err(io::Error::other("mmap(MAP_FIXED) placed the mapping elsewhere"));
     }
+    // Experiment (docs/research/measurements/restore-folios): no readahead for the
+    // snapshot's mapping, so that a fault reads one page into a folio of its own.
+    if std::env::var_os("SHARDS_RESTORE_RANDOM").is_some_and(|v| v == "1") {
+        // SAFETY: advice on the mapping just made.
+        unsafe { libc::madvise(at.as_ptr().cast(), len, libc::MADV_RANDOM) };
+    }
     Ok(())
 }
 
diff --git a/crates/vmm/src/snapshot/mod.rs b/crates/vmm/src/snapshot/mod.rs
