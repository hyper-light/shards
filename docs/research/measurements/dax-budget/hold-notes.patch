 /// Sets `cgroup`'s `memory.high` to `high`, never past what its host's budget leaves it
 /// ([`CAP`]): `max` for no hold at all.
+/// Appends `what` to /tmp/.shards-holds in the run's root, with the seconds since boot:
+/// the DAX budget job's hold-notes arm, which its guest's sampler reads.
+fn note_hold(what: &str) {
+    use std::io::Write as _;
+    let mut t = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // SAFETY: clock_gettime(2) into a timespec this function owns.
+    unsafe { libc::clock_gettime(libc::CLOCK_BOOTTIME, &mut t) };
+    if let Ok(mut f) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open("/tmp/.shards-holds")
+    {
+        let _ = writeln!(f, "{}.{:03} {what}", t.tv_sec, t.tv_nsec / 1_000_000);
+    }
+}
