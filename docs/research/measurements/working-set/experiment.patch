+/// Where the prefetch loop and its page list sit while it runs: below RAM, where the
+/// memory map has no device.
+const PREFETCH_IPA: u64 = 0x4000_0000;
+const PREFETCH_PAGE: usize = 16 << 10;
+/// `cbz x1, 2f; 1: ldr x2, [x0], #8; ldrb w3, [x2]; subs x1, x1, #1; b.ne 1b; 2: hvc #0`
+const PREFETCH_CODE: [u32; 6] = [
+    0xb400_00a1,
+    0xf840_8402,
+    0x3940_0043,
+    0xf100_0421,
+    0x54ff_ffa1,
+    0xd400_0002,
+];
+
+impl Vcpu {
+    /// Reads a byte of each of `pages` (guest-physical) from this vCPU, with its MMU off,
+    /// so that HVF maps them at stage 2 before the guest needs them. Call on a fresh vCPU
+    /// before its state is restored: it clobbers X0-X3, PC and PSTATE.
+    pub fn prefetch(&mut self, vm: &Vm, pages: &[u64]) -> Result<()> {
+        let list = (pages.len() * 8).next_multiple_of(PREFETCH_PAGE);
+        let size = PREFETCH_PAGE + list;
+        // SAFETY: a fresh anonymous mapping, unmapped below.
+        let host = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                size,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        if host == libc::MAP_FAILED {
+            return Err(Error::Guest(format!("prefetch scratch: {}", std::io::Error::last_os_error())));
+        }
+        // SAFETY: `host` spans `size` bytes: the code, then the list.
+        unsafe {
+            let code = host.cast::<u32>();
+            for (i, &w) in PREFETCH_CODE.iter().enumerate() {
+                code.add(i).write(w);
+            }
+            let list = host.cast::<u8>().add(PREFETCH_PAGE).cast::<u64>();
+            for (i, &p) in pages.iter().enumerate() {
+                list.add(i).write(p);
+            }
+        }
+        // SAFETY: `host` stays mapped until after the unmap below.
+        let ran = unsafe { vm.sys.map(host.cast(), PREFETCH_IPA, size, sys::Perms::RX) }
+            .map_err(Error::from)
+            .and_then(|()| self.run_prefetch(pages.len() as u64));
+        let unmapped = vm.sys.unmap(PREFETCH_IPA, size);
+        // SAFETY: unmapped from the guest above; ours alone.
+        unsafe { libc::munmap(host, size) };
+        ran?;
+        Ok(unmapped?)
+    }
+
+    fn run_prefetch(&mut self, n: u64) -> Result<()> {
+        self.sys.set_reg(sys::Reg::CPSR, sysreg::PSTATE_EL1H_DAIF)?;
+        self.sys.set_sys_reg(sysreg::SCTLR_EL1, sysreg::SCTLR_EL1_RESET)?;
+        self.sys.set_x(0, PREFETCH_IPA + PREFETCH_PAGE as u64)?;
+        self.sys.set_x(1, n)?;
+        self.sys.set_reg(sys::Reg::PC, PREFETCH_IPA)?;
+        loop {
+            match self.sys.run()? {
+                sys::Exit::Exception { syndrome, .. } if esr::ec(syndrome) == esr::EC_HVC64 => return Ok(()),
+                sys::Exit::Canceled => continue,
+                sys::Exit::Exception { syndrome, ipa, .. } => {
+                    return Err(Error::Guest(format!(
+                        "prefetch: EC {:#x} at IPA {ipa:#x}",
+                        esr::ec(syndrome)
+                    )));
+                }
+                other => return Err(Error::Guest(format!("prefetch: {other:?}"))),
+            }
+        }
+    }
+}
