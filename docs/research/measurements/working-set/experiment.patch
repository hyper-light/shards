+/// Arm 3: MMU on over an identity map of 1 GiB Normal write-back blocks; entries with bit
+/// 0 set get an atomic add of zero (a write, so the copy happens now), others a load. Ends
+/// with `tlbi vmalle1is`, so none of the map's translations outlive it.
+const PREFETCH_MMU_CODE: [u32; 15] = [
+    0xb400_0161, 0xf840_8402, 0x3700_00a2, 0x3940_0043, 0xf100_0421, 0x54ff_ff81, 0x1400_0005,
+    0x927f_f842, 0x383f_005f, 0xf100_0421, 0x54ff_fee1, 0xd508_831f, 0xd503_3b9f, 0xd503_3fdf,
+    0xd400_0002,
+];
+
+impl Vcpu {
+    pub fn prefetch_mmu(&mut self, vm: &Vm, pages: &[(u64, bool)]) -> Result<()> {
+        let list = (pages.len() * 8).next_multiple_of(PREFETCH_PAGE);
+        let size = PREFETCH_PAGE + list;
+        // SAFETY: a fresh anonymous mapping, unmapped below.
+        let host = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                size,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        if host == libc::MAP_FAILED {
+            return Err(Error::Guest(format!("prefetch scratch: {}", std::io::Error::last_os_error())));
+        }
+        const GIB: u64 = 1 << 30;
+        let block = |base: u64, exec: bool| -> u64 {
+            let xn = if exec { 1u64 << 54 } else { 3u64 << 53 };
+            (base & !(GIB - 1)) | xn | (1 << 10) | (3 << 8) | 0b01
+        };
+        // SAFETY: `host` spans `size` bytes: the code, the table at 4 KiB, then the list.
+        unsafe {
+            let code = host.cast::<u32>();
+            for (i, &w) in PREFETCH_MMU_CODE.iter().enumerate() {
+                code.add(i).write(w);
+            }
+            let table = host.cast::<u8>().add(4096).cast::<u64>();
+            table.add((PREFETCH_IPA / GIB) as usize).write(block(PREFETCH_IPA, true));
+            let list = host.cast::<u8>().add(PREFETCH_PAGE).cast::<u64>();
+            for (i, &(p, written)) in pages.iter().enumerate() {
+                let slot = (p / GIB) as usize;
+                if slot < 512 {
+                    table.add(slot).write(block(p, false));
+                }
+                list.add(i).write(p | u64::from(written));
+            }
+        }
+        // SAFETY: `host` stays mapped until after the unmap below.
+        let ran = unsafe { vm.sys.map(host.cast(), PREFETCH_IPA, size, sys::Perms::RX) }
+            .map_err(Error::from)
+            .and_then(|()| {
+                let ips = self.sys.sys_reg(sysreg::ID_AA64MMFR0_EL1)? & 0xf;
+                let tcr = 25 | (1 << 8) | (1 << 10) | (3 << 12) | (25 << 16) | (1 << 23) | (ips << 32);
+                self.sys.set_sys_reg(0xc510, 0xff)?; // MAIR_EL1: attr 0 Normal WB
+                self.sys.set_sys_reg(0xc102, tcr)?; // TCR_EL1
+                self.sys.set_sys_reg(0xc100, PREFETCH_IPA + 4096)?; // TTBR0_EL1
+                self.sys.set_reg(sys::Reg::CPSR, sysreg::PSTATE_EL1H_DAIF)?;
+                self.sys
+                    .set_sys_reg(sysreg::SCTLR_EL1, sysreg::SCTLR_EL1_RESET | 1 | (1 << 2) | (1 << 12))?;
+                self.sys.set_x(0, PREFETCH_IPA + PREFETCH_PAGE as u64)?;
+                self.sys.set_x(1, pages.len() as u64)?;
+                self.sys.set_reg(sys::Reg::PC, PREFETCH_IPA)?;
+                loop {
+                    match self.sys.run()? {
+                        sys::Exit::Exception { syndrome, .. } if esr::ec(syndrome) == esr::EC_HVC64 => {
+                            return Ok(());
+                        }
+                        sys::Exit::Canceled => continue,
+                        sys::Exit::Exception { syndrome, ipa, va } => {
+                            return Err(Error::Guest(format!(
+                                "prefetch: ESR {syndrome:#x} VA {va:#x} IPA {ipa:#x}"
+                            )));
+                        }
+                        other => return Err(Error::Guest(format!("prefetch: {other:?}"))),
+                    }
+                }
+            });
+        let unmapped = vm.sys.unmap(PREFETCH_IPA, size);
+        // SAFETY: unmapped from the guest above; ours alone.
+        unsafe { libc::munmap(host, size) };
+        ran?;
+        Ok(unmapped?)
+    }
+}
