+//! Measurement only (PM M30): with SHARDS_TRACK_PAGES=DIR, guest memory is mapped with
+//! no access, and each 16 KiB page's first touch exits to the VMM, which records it and
+//! opens the page. A read or fetch opens it read-execute, so a later write exits again.
+
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+use super::ffi;
+
+const PAGE: u64 = 16 << 10;
+
+pub struct Region {
+    pub base: u64,
+    pub len: u64,
+    pub full: u64,
+}
+
+#[derive(Clone, Copy)]
+pub struct Page {
+    pub first_us: u128,
+    pub kind: u8,
+    pub write_us: u128,
+}
+
+pub struct Tracker {
+    pub dir: String,
+    pub regions: Mutex<Vec<Region>>,
+    pub pages: Mutex<HashMap<u64, Page>>,
+    pub since: Mutex<u128>,
+}
+
+static TRACKER: OnceLock<Option<Tracker>> = OnceLock::new();
+
+pub fn get() -> Option<&'static Tracker> {
+    TRACKER
+        .get_or_init(|| {
+            std::env::var("SHARDS_TRACK_PAGES").ok().map(|dir| Tracker {
+                dir,
+                regions: Mutex::new(Vec::new()),
+                pages: Mutex::new(HashMap::new()),
+                since: Mutex::new(0),
+            })
+        })
+        .as_ref()
+}
+
+/// Takes a freshly mapped region away from the guest, to see its first touches.
+pub fn watch(base: u64, len: u64, full: u64) {
+    let Some(t) = get() else { return };
+    // SAFETY: the region was just mapped.
+    let rc = unsafe { hv_vm_protect(base, len as usize, 0) };
+    if rc != ffi::HV_SUCCESS {
+        crate::warn!("hv_vm_protect {base:#x}: {rc:#x}");
+        return;
+    }
+    if let Ok(mut r) = t.regions.lock() {
+        r.push(Region { base, len, full });
+    }
+}
+
+/// Takes every watched region away again and forgets what was touched: from a snapshot
+/// point on.
+pub fn rewatch() {
+    let Some(t) = get() else { return };
+    if let Ok(r) = t.regions.lock() {
+        for g in r.iter() {
+            // SAFETY: the region is mapped.
+            unsafe { hv_vm_protect(g.base, g.len as usize, 0) };
+        }
+    }
+    if let Ok(mut p) = t.pages.lock() {
+        p.clear();
+    }
+    if let Ok(mut s) = t.since.lock() {
+        *s = crate::log::uptime_us();
+    }
+}
+
+/// Handles a stage-2 fault on a watched page; false when `ipa` is not one.
+pub fn fault(ec: u32, syndrome: u64, ipa: u64) -> bool {
+    let Some(t) = get() else { return false };
+    let Some(full) = t.regions.lock().ok().and_then(|r| {
+        r.iter()
+            .find(|g| ipa >= g.base && ipa - g.base < g.len)
+            .map(|g| g.full)
+    }) else {
+        return false;
+    };
+    let walk = syndrome & (1 << 7) != 0;
+    let kind = if ec == 0x20 {
+        b'x'
+    } else if walk {
+        b'p'
+    } else if syndrome & (1 << 6) != 0 {
+        b'w'
+    } else {
+        b'r'
+    };
+    let writes = kind == b'w' || kind == b'p';
+    if writes && full & ffi::HV_MEMORY_WRITE == 0 {
+        return false;
+    }
+    let page = ipa & !(PAGE - 1);
+    let now = crate::log::uptime_us();
+    if let Ok(mut pages) = t.pages.lock() {
+        let e = pages.entry(page).or_insert(Page {
+            first_us: now,
+            kind,
+            write_us: 0,
+        });
+        if writes && e.write_us == 0 {
+            e.write_us = now;
+        }
+    }
+    let perms = if writes {
+        full
+    } else {
+        ffi::HV_MEMORY_READ | ffi::HV_MEMORY_EXEC
+    };
+    // SAFETY: the page lies in a mapped region.
+    let rc = unsafe { hv_vm_protect(page, PAGE as usize, perms) };
+    rc == ffi::HV_SUCCESS
+}
+
+/// Writes DIR/PID.pages: the regions, then each page as `ipa first_us kind write_us`.
+pub fn dump(header: &str) {
+    let Some(t) = get() else { return };
+    let since = t.since.lock().map(|s| *s).unwrap_or(0);
+    let mut out = format!("{header} rewatched_us {since}\n");
+    if let Ok(r) = t.regions.lock() {
+        for g in r.iter() {
+            out.push_str(&format!("region {:#x} {:#x} {}\n", g.base, g.len, g.full));
+        }
+    }
+    if let Ok(p) = t.pages.lock() {
+        let mut v: Vec<_> = p.iter().map(|(&k, &v)| (k, v)).collect();
+        v.sort_by_key(|&(_, p)| p.first_us);
+        for (ipa, p) in v {
+            out.push_str(&format!(
+                "{ipa:#x} {} {} {}\n",
+                p.first_us, p.kind as char, p.write_us
+            ));
+        }
+    }
+    let _ = std::fs::write(format!("{}/{}.pages", t.dir, std::process::id()), out);
+}
+
+#[link(name = "Hypervisor", kind = "framework")]
+unsafe extern "C" {
+    fn hv_vm_protect(ipa: u64, size: usize, flags: u64) -> i32;
+}
