+mod root_actual_start_oom {
+ use super::*;
+ #[test]
+ fn typed_start_returns_after_real_construction_under_refusal() {
+  let kernel=std::env::var_os("SHARDS_KERNEL").expect("explicit root experimental kernel");
+  let mut cfg=Config::new(kernel.into(),None);
+  cfg.memory_mib=256;
+  cfg.console=Console::Discard;
+  cfg.cmdline="x".repeat(crate::arch::x86_64::layout::CMDLINE_MAX);
+  let before=std::fs::read_dir("/proc/self/fd").unwrap().count();
+  ROOT_ARM_CMDLINE.store(true,std::sync::atomic::Ordering::SeqCst);
+  let result=start(&cfg);
+  root_faults::reset();
+  let armed_not_reached=ROOT_ARM_CMDLINE.swap(false,std::sync::atomic::Ordering::SeqCst);
+  let after=std::fs::read_dir("/proc/self/fd").unwrap().count();
+  assert!(!armed_not_reached,"actual command-line bridge was not reached");
+  match result {
+   Err(StartError::CommandLine(crate::arch::x86_64::boot::BootError::DoesNotFit{what,at,len})) => {
+    assert_eq!(what,"command line");assert_eq!(at,crate::arch::x86_64::layout::CMDLINE);
+    eprintln!("ACTUAL_TYPED_START_RETURN what={what} at={at} len={len} before_fds={before} after_fds={after}");
+   },
+   Err(other)=>panic!("wrong actual startup cause: {other}"),
+   Ok(_)=>panic!("overlong command line unexpectedly booted"),
+  }
+  assert_eq!(before,after,"actual start error leaked process descriptors");
+ }
