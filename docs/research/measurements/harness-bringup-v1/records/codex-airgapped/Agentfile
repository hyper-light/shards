# OpenAI's Codex CLI as a harness, started by its own harness.json (architecture.md D54):
# no RUN or VOLUME installs it, and no credential is in the image.
#
# Put OpenAI's static Linux builds for the host's architecture in codex/bin first: codex,
# and codex-code-mode-host, which codex starts from its own directory (OpenAI's package
# carries both). docs/research/measurements/harness-bringup-v1/fetch.sh fetches and
# verifies x86_64's.
#   shards build image -t harness-codex:1 docs/examples/harness-codex
#   shards run vm -d --name codex harness-codex:1 sleep 600
#   shards read processes codex
FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

HARNESS codex FROM ./codex

# Its network reach, every part named (default deny, AGENTFILE_ARCH.md §4.6, §4.7, §9.7):
# a network for this harness alone, which it joins with no flow to any member; names past
# the microVM through the microVM's resolver (--dns); and TCP 443 out, opened both at the
# network's boundary (--egress) and at the microVM's (EXPOSE ... AS egress). Nothing comes
# in, and no other port or protocol goes out.
