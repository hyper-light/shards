+    /// Member 0's `channel` of a run, bound as `start_managed_capture` binds it.
+    fn bound(
+        server: &identity::Identity,
+        owner: Fingerprint,
+        channel: Channel,
+        capacity: usize,
+    ) -> (Scope, Endpoint, Producer, Control) {
+        let scope = Scope {
+            run: RunId([7; 32]),
+            generation: 1,
+            member: 0,
+            channel,
+        };
+        let (endpoint, producer, control) =
+            Endpoint::bind(server, owner, scope, admitted(capacity, shards_remote::tls::QUIET)).unwrap();
+        (scope, endpoint, producer, control)
+    }
