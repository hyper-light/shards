+/// Experiment, not for main: how often an exec's frame is still on its way as a pause asked
+/// at once after it holds its guest.
+#[test]
+#[ignore]
+fn paused_exec_race_experiment() {
+    let Some((home, image)) = home("containers-race") else {
+        return;
+    };
+    let mut run = start(
+        &home,
+        &image,
+        &["--name", "race", "--stop-signal", "TERM"],
+        &["sleep"],
+    );
+    let env = home.join("big.env");
+    let lines: String = (0..90)
+        .map(|i| format!("BIG{i}={}\n", "x".repeat(64 << 10)))
+        .collect();
+    std::fs::write(&env, lines).unwrap();
+    let vm = shards_in(&home, &["inspect", "-f", "{{.State.Pid}}", "race"]);
+    let spawn = |args: &[&str], err: &Path| {
+        common::command()
+            .args(args)
+            .env("SHARDS_HOME", &*home)
+            .env("SHARDS_KERNEL", kernel())
+            .env("SHARDS_INIT", guest_init())
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(std::fs::File::create(err).unwrap())
+            .spawn()
+            .unwrap()
+    };
+    let env_arg = env.to_str().unwrap().to_string();
+    for attempt in 0..60u64 {
+        let said = home.join(format!("exec-{attempt}.stderr"));
+        let mut exec = spawn(
+            &[
+                "exec",
+                "--env-file",
+                &env_arg,
+                "race",
+                "/bin/testguest",
+                "exit",
+                "0",
+            ],
+            &said,
+        );
+        std::thread::sleep(Duration::from_millis(attempt % 12));
+        let t = Instant::now();
+        let paused = shards_in(&home, &["pause", "race"]);
+        let pause_took = t.elapsed();
+        let t = Instant::now();
+        let signalled = shards_in(&home, &["kill", "-s", "WINCH", "race"]);
+        let kill_took = t.elapsed();
+        eprintln!(
+            "attempt {attempt}: delay {} ms, pause {:?} in {pause_took:?}, kill {:?} in {kill_took:?}, VM {}",
+            attempt % 12,
+            paused.status,
+            signalled.status,
+            vm.stdout.trim()
+        );
+        let t = Instant::now();
+        let unpaused = shards_in_within(&home, &["unpause", "race"], Duration::from_secs(30));
+        eprintln!(
+            "attempt {attempt}: unpause {:?} in {:?}",
+            unpaused.status,
+            t.elapsed()
+        );
+        let ended = exit(&mut exec, &home);
+        eprintln!(
+            "attempt {attempt}: exec {ended:?}: {}",
+            std::fs::read_to_string(&said).unwrap_or_default().trim()
+        );
+    }
+    assert_eq!(shards_in(&home, &["kill", "race"]).status, Some(0));
+    let _ = exit(&mut run, &home);
+}
