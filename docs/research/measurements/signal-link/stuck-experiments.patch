+/// A paused microVM's unpause, and a signal sent to it, wait for no exec on its way to its
+/// guest: here one whose frame is far more than the signal connection's host sockets and its
+/// guest's window hold, sent as the run, held to a hundredth of a CPU so that its guest reads
+/// it slowly, is paused partway through (the daemon refuses an exec into a microVM paused
+/// already). Before, the exec's send held the link's lock until its guest read it, the signal
+/// waited for that lock in the VM's relay of its daemon, and the unpause behind it was never
+/// read: the microVM stayed paused, and `unpause` and the exec waited for ever (D16).
+#[test]
+fn a_paused_microvms_unpause_waits_for_no_exec_on_its_way() {
+    let Some((home, image)) = home("containers-paused-exec") else {
+        return;
+    };
+    let mut run = start(&home, &image, &["--name", "slow", "--cpus", "0.01"], &["sleep"]);
+    // 5 MiB of environment, near the most a frame carries (run::MAX_PAYLOAD, 6 MiB).
+    let env = home.join("big.env");
+    let lines: String = (0..80)
+        .map(|i| format!("BIG{i}={}\n", "x".repeat(64 << 10)))
+        .collect();
+    std::fs::write(&env, lines).unwrap();
+    let said = home.join("exec.stderr");
+    let mut exec = common::command()
+        .args(["exec", "--env-file"])
+        .arg(&env)
+        .args(["slow", "/bin/testguest", "exit", "0"])
+        .env("SHARDS_HOME", &*home)
+        .env("SHARDS_KERNEL", kernel())
+        .env("SHARDS_INIT", guest_init())
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(std::fs::File::create(&said).unwrap())
+        .spawn()
+        .unwrap();
+    // Its frame on its way as the guest, a hundredth of a CPU's, reads it.
+    std::thread::sleep(Duration::from_secs(1));
+    let paused = shards_in(&home, &["pause", "slow"]);
+    assert_eq!(paused.status, Some(0), "{paused}");
+    let vm = shards_in(&home, &["inspect", "-f", "{{.State.Pid}}", "slow"]);
+    eprintln!("the paused microVM's VM process: {}", vm.stdout.trim());
+    // SIGWINCH, which the command ignores, through its daemon's link with its VM.
+    let signalled = shards_in(&home, &["kill", "-s", "WINCH", "slow"]);
+    assert_eq!(signalled.status, Some(0), "{signalled}");
+    let unpaused = shards_in(&home, &["unpause", "slow"]);
+    assert_eq!(
+        (unpaused.status, unpaused.stdout.as_str()),
+        (Some(0), "slow\n"),
+        "{unpaused}"
+    );
+    let ran = exit(&mut exec, &home);
+    assert_eq!(
+        ran,
+        Some(0),
+        "the exec: {}",
+        std::fs::read_to_string(&said).unwrap_or_default()
+    );
+    assert_eq!(shards_in(&home, &["kill", "slow"]).status, Some(0));
+    assert_eq!(exit(&mut run, &home), Some(137));
+}
