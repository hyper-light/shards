+/// Experiment, not for main: execs streaming frames larger than the signal connection holds,
+/// so that one is on its way most of the time, as a pause holds the guest.
+#[test]
+#[ignore]
+fn paused_exec_stream_experiment() {
+    let Some((home, image)) = home("containers-stream") else {
+        return;
+    };
+    let mut run = start(&home, &image, &["--name", "busy", "--stop-signal", "TERM"], &["sleep"]);
+    let env = home.join("big.env");
+    let lines: String = (0..24).map(|i| format!("BIG{i}={}\n", "x".repeat(64 << 10))).collect();
+    std::fs::write(&env, lines).unwrap();
+    let vm = shards_in(&home, &["inspect", "-f", "{{.State.Pid}}", "busy"]);
+    let stop = std::sync::atomic::AtomicBool::new(false);
+    let env_arg = env.to_str().unwrap();
+    std::thread::scope(|s| {
+        let loops: Vec<_> = (0..16)
+            .map(|_| {
+                s.spawn(|| {
+                    let mut ends = std::collections::BTreeMap::<String, u32>::new();
+                    while !stop.load(std::sync::atomic::Ordering::Relaxed) {
+                        let ran = shards_in_within(
+                            &home,
+                            &["exec", "--env-file", env_arg, "busy", "/bin/testguest", "exit", "0"],
+                            Duration::from_secs(120),
+                        );
+                        let said = ran.stderr.lines().last().unwrap_or_default().to_string();
+                        *ends.entry(format!("{:?} {said}", ran.status)).or_default() += 1;
+                    }
+                    ends
+                })
+            })
+            .collect();
+        for round in 0..10 {
+            std::thread::sleep(Duration::from_millis(700));
+            let t = Instant::now();
+            let paused = shards_in(&home, &["pause", "busy"]);
+            let signalled = shards_in(&home, &["kill", "-s", "WINCH", "busy"]);
+            eprintln!(
+                "round {round}: pause {:?}, kill {:?} in {:?}, VM {}",
+                paused.status,
+                signalled.status,
+                t.elapsed(),
+                vm.stdout.trim()
+            );
+            let t = Instant::now();
+            let unpaused = shards_in_within(&home, &["unpause", "busy"], Duration::from_secs(30));
+            eprintln!("round {round}: unpause {:?} in {:?}", unpaused.status, t.elapsed());
+        }
+        stop.store(true, std::sync::atomic::Ordering::Relaxed);
+        for l in loops {
+            eprintln!("an exec loop's ends: {:?}", l.join().unwrap());
+        }
+    });
+    assert_eq!(shards_in(&home, &["kill", "busy"]).status, Some(0));
+    let _ = exit(&mut run, &home);
+}
