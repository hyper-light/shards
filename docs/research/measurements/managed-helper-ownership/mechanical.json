{
  "policy": {
    "command": [
      "python3",
      "scripts/check-development-policy"
    ],
    "exit": 0,
    "stdout": "Development policy checks passed; evidence/coordinator review is still required.\n",
    "stderr": ""
  },
  "fmt": {
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--check"
    ],
    "exit": 0,
    "stdout": "",
    "stderr": ""
  },
  "source_whitespace": {
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit": 0,
    "stdout": "",
    "stderr": ""
  }
}
