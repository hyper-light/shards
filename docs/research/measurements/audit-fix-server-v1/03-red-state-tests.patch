+        assert!(two_ran_on, "the other worker was ended with it");
+        assert!(second.iter().any(|(id, _, _)| *id == 2), "{second:?}");
+        assert!(two_ended);
+        assert!(libc::WIFEXITED(status) && libc::WEXITSTATUS(status) == 0, "{status:#x}");
+    }
