+        assert_eq!(checked(text).unwrap_err(), refused, "{text}");
+    }
+    // Another lineage's domains are not beside it.
+    checked("FROM alpine AS agents\nAGENT a FROM ./a\nFROM alpine\nNESTING\n").unwrap();
