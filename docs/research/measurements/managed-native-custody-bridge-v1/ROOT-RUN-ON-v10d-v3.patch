+#[cfg(test)]
+mod startup_custody_tests {
+    use super::*;
+    use std::os::unix::net::UnixStream;
+
+    fn connection() -> (File, UnixStream) {
+        let (writer, reader) = UnixStream::pair().unwrap();
+        (File::from(OwnedFd::from(writer)), reader)
+    }
+
+    fn system_error(reader: &mut UnixStream) -> Vec<u8> {
+        let mut header = [0; run::HEADER];
+        reader.read_exact(&mut header).unwrap();
+        let (kind, length) = run::parse_header(header).unwrap();
+        assert_eq!(kind, kind::SYSTEM_ERR);
+        let mut message = vec![0; length as usize];
+        reader.read_exact(&mut message).unwrap();
+        message
+    }
+
+    #[test]
+    fn member_start_refusals_report_system_error_and_not_run() {
+        let (conn, mut reader) = connection();
+        let refusals = [
+            crate::domains::StartFailure::Clone {
+                member: 7,
+                actual: -1,
+                cause: io::Error::from_raw_os_error(libc::EPERM),
+            },
+            crate::domains::StartFailure::Pid {
+                member: 8,
+                actual: libc::c_long::MAX,
+            },
+            crate::domains::StartFailure::StartupState,
+            crate::domains::StartFailure::StartupAllocation,
+            crate::domains::StartFailure::MetadataAllocation { member: 10 },
+        ];
+        let mut answers = Vec::new();
+        for cause in refusals {
+            let expected = run::render_error(&cause);
+            let failure = domain_start_failed(cause, &Spec::default());
+            let answer = report_startup_failure(&conn, &failure);
+            if answer.is_some() {
+                assert_eq!(system_error(&mut reader), expected.as_bytes());
+            }
+            answers.push(answer);
+        }
+        assert_eq!(
+            answers,
+            [Some(NOT_RUN); 5],
+            "typed member refusal must answer SYSTEM_ERR with NOT_RUN"
+        );
+        let unknown = domain_start_failed(
+            crate::domains::StartFailure::NativeOwner {
+                member: 11,
+                cause: crate::managed::NativeFailure::State,
+            },
+            &Spec::default(),
+        );
+        assert_eq!(report_startup_failure(&conn, &unknown), None);
+        reader.set_nonblocking(true).unwrap();
+        let mut byte = [0];
+        assert_eq!(
+            reader.read(&mut byte).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
     }
+
+    #[test]
+    fn pre_birth_refusals_report_system_error_and_not_run() {
+        let (conn, mut reader) = connection();
+        let refusals = [
+            crate::domains::StartFailure::MissingStartup,
+            crate::domains::StartFailure::MissingNativeOwner,
+            crate::domains::StartFailure::OwnerPreparation {
+                member: 12,
+                cause: crate::managed::PreparationFailure::State,
+            },
+            crate::domains::StartFailure::InputPreparation {
+                member: 13,
+                cause: crate::input::startup::Failure::Member,
+            },
+            crate::domains::StartFailure::HelperPreparation {
+                member: 14,
+                cause: crate::domains::HelperPreparationFailure::Map(
+                    shards_ipc::child_fds::Failure::Capacity,
+                ),
+            },
+            crate::domains::StartFailure::Preparation {
+                member: 15,
+                cause: crate::domains::DeclaredPathFailure::Nul,
+            },
+        ];
+        let mut answers = Vec::new();
+        for cause in refusals {
+            let expected = run::render_error(&cause);
+            let failure = domain_start_failed(cause, &Spec::default());
+            let answer = report_startup_failure(&conn, &failure);
+            if answer.is_some() {
+                assert_eq!(system_error(&mut reader), expected.as_bytes());
+            }
+            answers.push(answer);
+        }
+        assert_eq!(
+            answers,
+            [Some(NOT_RUN); 6],
+            "pre-birth refusal must answer SYSTEM_ERR with NOT_RUN"
+        );
+    }
+
+    #[test]
+    fn rejected_parent_group_survives_system_error_until_owner_drop() {
+        let (group, mut peer) = UnixStream::pair().unwrap();
+        peer.set_nonblocking(true).unwrap();
+        let mut pending = crate::managed::PendingMember::new();
+        // The real vacant-phase guard rejects the actual descriptor before
+        // inspecting the PID; no member/child/cgroup or authority is fabricated.
+        let cause = match pending.parent(0, File::from(OwnedFd::from(group))) {
+            Ok(_) => panic!("vacant custody accepted a parent"),
+            Err(cause) => cause,
+        };
+        assert!(pending.vacant());
+        let original = crate::domains::StartFailure::OwnerParent { member: 9, cause };
+        let expected = run::render_error(&original);
+        let failure = domain_start_failed(original, &Spec::default());
+        let (conn, mut reader) = connection();
+        assert_eq!(
+            report_startup_failure(&conn, &failure),
+            Some(NOT_RUN),
+            "typed member refusal must answer SYSTEM_ERR with NOT_RUN"
+        );
+        assert_eq!(system_error(&mut reader), expected.as_bytes());
+        // The peer reads EOF only once the socket itself closes: this observes
+        // the rejected group's object, never a reusable descriptor number.
+        let mut byte = [0];
+        assert_eq!(
+            peer.read(&mut byte).map_err(|e| e.kind()),
+            Err(io::ErrorKind::WouldBlock),
+            "rejected group was released before its startup failure"
+        );
+        drop(failure);
+        assert_eq!(
+            peer.read(&mut byte).map_err(|e| e.kind()),
+            Ok(0),
+            "dropping the startup failure must release the rejected group"
+        );
+    }
 }
