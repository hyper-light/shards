+
+fn report_startup_failure(conn: &File, failure: &StartupFailure) -> Option<u32> {
+    match failure {
+        StartupFailure::OwnerState => {
+            let _ = writeln!(io::stderr(), "shards-init: run owner state is invalid");
+            None
+        }
+        StartupFailure::Setup(f) => {
+            let _ = send(conn, kind::SYSTEM_ERR, f.message.as_bytes());
+            Some(f.status)
+        }
+        StartupFailure::Management(report) => {
+            let _ = send(conn, kind::MANAGEMENT_REFUSED, &report.encode());
+            Some(NOT_RUN)
+        }
+        StartupFailure::Control { member, cause } => {
+            report_owner_control(*member, cause);
+            None
+        }
+        StartupFailure::UnreportedLaunch { member, failure } => {
+            // A missing protected binding/canonical cause cannot manufacture an
+            // Epoch or credential selection. The host retains VM-loss Unknown.
+            let _ = (member, failure);
+            None
+        }
+        StartupFailure::UnreportedDomain(failure) => {
+            use std::os::fd::AsFd as _;
+            if let Ok(fd) = io::stderr().as_fd().try_clone_to_owned() {
+                let _ = writeln!(File::from(fd), "shards-init: domain startup {failure}");
+            }
+            None
+        }
     }
 }
 
