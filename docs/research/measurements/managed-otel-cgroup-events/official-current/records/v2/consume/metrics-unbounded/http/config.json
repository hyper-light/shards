{
  "receivers": {
    "otlp": {
      "protocols": {
        "http": {
          "endpoint": "127.0.0.1:50587"
        }
      }
    }
  },
  "exporters": {
    "debug": {
      "verbosity": "detailed"
    }
  },
  "service": {
    "telemetry": {
      "metrics": {
        "level": "none"
      },
      "logs": {
        "encoding": "json",
        "sampling": {
          "enabled": false
        }
      }
    },
    "pipelines": {
      "metrics": {
        "receivers": [
          "otlp"
        ],
        "exporters": [
          "debug"
        ]
      }
    }
  }
}
