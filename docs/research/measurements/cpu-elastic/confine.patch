+/// Experiment (docs/research/measurements/cpu-elastic, confine): where a run's cpuset is
+/// fewer than the guest's online CPUs, init's own processes (a cgroup of the run's cpuset
+/// alone, no other limit), the kernel's unbound workqueues and its interrupts go to the
+/// run's CPUs, so that a start's work stays on them and the rest stay idle.
+fn confine_to_run(cgroup: &[Vec<u8>]) {
+    let Some(cpus) = cgroup.iter().find_map(|e| e.strip_prefix(b"cpuset.cpus=")) else {
+        return;
+    };
+    let cpus = String::from_utf8_lossy(cpus).trim().to_string();
+    let online = std::fs::read_to_string("/sys/devices/system/cpu/online").unwrap_or_default();
+    if cpus.is_empty() || cpus == online.trim() {
+        return;
+    }
+    let mut bits: Vec<u32> = Vec::new();
+    for part in cpus.split(',') {
+        let (lo, hi) = part.split_once('-').unwrap_or((part, part));
+        let (Ok(lo), Ok(hi)) = (lo.trim().parse::<usize>(), hi.trim().parse::<usize>()) else {
+            return;
+        };
+        for cpu in lo..=hi.min(4095) {
+            let word = cpu / 32;
+            if bits.len() <= word {
+                bits.resize(word + 1, 0);
+            }
+            if let Some(w) = bits.get_mut(word) {
+                *w |= 1 << (cpu % 32);
+            }
+        }
+    }
+    let mask: Vec<String> = bits.iter().rev().map(|w| format!("{w:08x}")).collect();
+    let mask = mask.join(",");
+    let dir = "/sys/fs/cgroup/init-cpus";
+    let _ = std::fs::create_dir(dir);
+    let _ = std::fs::write(format!("{dir}/cpuset.cpus"), &cpus);
+    if let Ok(procs) = std::fs::read_to_string("/sys/fs/cgroup/cgroup.procs") {
+        for pid in procs.lines() {
+            let _ = std::fs::write(format!("{dir}/cgroup.procs"), pid);
+        }
+    }
+    let _ = std::fs::write("/sys/devices/virtual/workqueue/cpumask", &mask);
+    let _ = std::fs::write("/proc/irq/default_smp_affinity", &mask);
+    if let Ok(irqs) = std::fs::read_dir("/proc/irq") {
+        for irq in irqs.flatten() {
+            let _ = std::fs::write(irq.path().join("smp_affinity_list"), &cpus);
+        }
+    }
+}
