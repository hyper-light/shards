+#[cfg(all(test, unix))]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    /// A guest's exec connection is admitted while an exec thread holds the waiters' lock,
+    /// as each does while it registers: refused as full, the muxer reset it, and its exec
+    /// waited for ever (ROOT's 64 execs at once, 2026-11-12).
+    #[test]
+    fn admission_takes_a_connection_while_the_waiters_lock_is_held() {
+        let (port, _acceptor) = exec_port().unwrap();
+        let (to, _gets) = std::sync::mpsc::sync_channel(1);
+        super::super::register([31; run::TOKEN], super::super::Target::Exec { id: 31, to }).unwrap();
+        let busy = super::super::pending();
+        let (_guest, host) = UnixStream::pair().unwrap();
+        let admitted = port.accept(host);
+        drop(busy);
+        assert_eq!(admitted, Admission::Accepted);
+    }
+
+    /// The same, the listener's lock held: an exec registering takes it too.
+    #[test]
+    fn admission_takes_a_connection_while_the_listeners_lock_is_held() {
+        let (port, _acceptor) = exec_port().unwrap();
+        let (to, _gets) = std::sync::mpsc::sync_channel(1);
+        super::super::register([32; run::TOKEN], super::super::Target::Exec { id: 32, to }).unwrap();
+        let busy = STATE.lock().unwrap();
+        let (_guest, host) = UnixStream::pair().unwrap();
+        let admitted = port.accept(host);
+        drop(busy);
+        assert_eq!(admitted, Admission::Accepted);
+    }
+}
