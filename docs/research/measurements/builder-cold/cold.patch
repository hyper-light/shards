+/// The build's memory now, a line for docs/research/measurements/builder-cold: its
+/// cgroup's charge, peak, files and anonymous memory, what is plugged and asked for, and
+/// what of what is plugged lies past twice what it uses, in whole memory blocks.
+pub fn measure_line(cgroup: &str) -> String {
+    let stat = std::fs::read_to_string(format!("{cgroup}/memory.stat")).unwrap_or_default();
+    let field = |k: &str| {
+        stat.lines()
+            .find_map(|l| l.strip_prefix(k).and_then(|r| r.strip_prefix(' ')))
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .unwrap_or(0)
+    };
+    let current = number(&format!("{cgroup}/memory.current")).unwrap_or(0);
+    let peak = number(&format!("{cgroup}/memory.peak")).unwrap_or(0);
+    let swap = number(&format!("{cgroup}/memory.swap.current")).unwrap_or(0);
+    let boot = BOOT.get().copied().unwrap_or(0);
+    let (total, free) = memory().unwrap_or((0, 0));
+    let plugged = total.saturating_sub(boot);
+    let asked = control_read64(control::HOTPLUG_REQUEST).unwrap_or(0);
+    let most = control_read64(control::HOTPLUG_SIZE).unwrap_or(0);
+    let keep = current
+        .saturating_mul(2)
+        .saturating_sub(boot)
+        .checked_next_multiple_of(ALIGN)
+        .unwrap_or(u64::MAX)
+        .min(most);
+    let mut t = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: clock_gettime(2) writes `t`.
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut t) };
+    format!(
+        "builder-cold t_ms {} current {current} peak {peak} file {} active_file {} inactive_file {} anon {} shmem {} swap {swap} total {total} free {free} boot {boot} plugged {plugged} asked {asked} most {most} past_twice_used {}",
+        t.tv_sec * 1000 + t.tv_nsec / 1_000_000,
+        field("file"),
+        field("active_file"),
+        field("inactive_file"),
+        field("anon"),
+        field("shmem"),
+        plugged.saturating_sub(keep)
+    )
+}
