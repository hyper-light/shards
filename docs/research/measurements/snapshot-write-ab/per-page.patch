The Firecracker comparison's restores (crates/shards/benches/firecracker.rs) with a third
variant: shards' snapshot, copied with its memory rewritten one page per pwrite of each
page that is not all zero, as GuestMemory::save wrote it before e9ed44d (PM M37). Each
iteration restores the batched snapshot, the copy and Firecracker's; the copy goes first
or last in turn. On a Linux host with KVM:

  git apply docs/research/measurements/snapshot-write-ab/per-page.patch
  cargo bench -p shards --bench firecracker -- --runs 20

--- a/crates/shards/benches/firecracker.rs
+++ b/crates/shards/benches/firecracker.rs
@@ -198,6 +198,27 @@
             "shards' snapshot: {}",
             String::from_utf8_lossy(&saved.stderr)
         );
+        // The same snapshot with its memory written one page per pwrite, as shards wrote it
+        // before e9ed44d (PM M37), restored beside it.
+        let perpage = dir.join("shards-perpage");
+        std::fs::create_dir_all(&perpage).unwrap();
+        for entry in std::fs::read_dir(&snapshot).unwrap() {
+            let entry = entry.unwrap();
+            let to = perpage.join(entry.file_name());
+            if entry.file_name() == "memory" {
+                use std::os::unix::fs::FileExt;
+                let bytes = std::fs::read(entry.path()).unwrap();
+                let f = std::fs::File::create(&to).unwrap();
+                for (i, page) in bytes.chunks(4096).enumerate() {
+                    if page.iter().any(|&b| b != 0) {
+                        f.write_all_at(page, (i * 4096) as u64).unwrap();
+                    }
+                }
+                f.set_len(bytes.len() as u64).unwrap();
+            } else {
+                std::fs::copy(entry.path(), &to).unwrap();
+            }
+        }
 
         // Firecracker: booted from its config, paused and snapshotted through its API.
         let (fc_state, fc_memory) = (dir.join("fc.state"), dir.join("fc.memory"));
