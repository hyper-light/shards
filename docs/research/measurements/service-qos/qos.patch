+/// M22: user-interactive QoS on the calling thread when SHARDS_M22_QOS=1.
+pub fn m22_qos() {
+    #[cfg(target_os = "macos")]
+    if std::env::var_os("SHARDS_M22_QOS").is_some_and(|v| v == "1") {
+        macos_thread::make_current_interactive();
+    }
+}
