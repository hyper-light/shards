+/// M22: QoS user-interactive only.
+pub fn make_current_interactive() {
+    // SAFETY: a plain call on the current thread.
+    unsafe { libc::pthread_set_qos_class_self_np(libc::qos_class_t::QOS_CLASS_USER_INTERACTIVE, 0) };
+}
