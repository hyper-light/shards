+/// A GPU's runs' filter, loaded before any snapshot where the VM has a GPU: Docker's
+/// rules and its render node's, which every run given the GPU has.
+static GPU: std::sync::OnceLock<Filter> = std::sync::OnceLock::new();
+
 /// Confines `cgroup` to Docker's default devices (moby's rules and runc's own), as boot
 /// does before any snapshot: every run with those rules, the most, then has them already.
+/// Where the VM has a GPU, its runs' filter is loaded too ([`GPU`]).
 pub fn confine_by_default(cgroup: &str) -> Result<(), String> {
     let program = dc::compile(&dc::container(&[], &[], false))?;
     let fd = attach(&program, cgroup, None)?;
     DEFAULT
         .set((program, fd))
-        .map_err(|_| "the default device filter, twice".to_string())
+        .map_err(|_| "the default device filter, twice".to_string())?;
+    if let [node] = vm_devices(RENDER_NODE).as_slice() {
+        let given = dc::Given {
+            path: node.path.clone(),
+            rule: Rule {
+                kind: node.kind,
+                major: i64::from(node.major),
+                minor: i64::from(node.minor),
+                perms: dc::RWM,
+                allow: true,
+            },
+        };
+        let program = dc::compile(&dc::container(&[given], &[], false))?;
+        let fd = load(&program)?;
+        let _ = GPU.set((program, fd));
+    }
+    Ok(())
 }
 
