+#[cfg(test)]
+mod reference_query_tests {
+    use super::{A, Term, Type, TypeEnv, builtin_ref};
+
+    #[test]
+    fn dynamic_references_preserve_scalar_and_function_value_types() {
+        let path = [
+            Term::var("data", None),
+            Term::string("docs", None),
+            Term::var("key", None),
+        ];
+        for scalar in [Type::Null, Type::Boolean, Type::Number, Type::String, A] {
+            let env = TypeEnv::with_builtins(std::iter::once(("data.docs.value", &scalar)));
+            assert!(matches!(env.get_by_ref(&path), Type::Any(of) if of.is_empty()));
+            let mut nested = path.to_vec();
+            nested.push(Term::string("nested", None));
+            assert!(matches!(env.get_by_ref(&nested), Type::Any(of) if of.is_empty()));
+        }
+        let function = Type::function(vec![Type::Number], Type::Number);
+        let env = TypeEnv::with_builtins(std::iter::once(("data.docs.value", &function)));
+        assert!(env.get_by_ref(&path).is_nil());
+        assert!(matches!(
+            env.get_by_ref(&builtin_ref("data.docs.value")),
+            Type::Function { .. }
+        ));
+    }
