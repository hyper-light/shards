#!/bin/sh
# Regenerates crates/shards/src/build/testdata/github-attestation.json: what buildx
# v0.37.1's own github_attestation helpers (policy/funcs.go) and the golang/snappy v1.0.0
# it vendors make of each case of scripts/policy/github_oracle_test.go.
#
#   scripts/policy/generate-github BUILDX_V0.37.1_CHECKOUT
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
bx=$1
test="$bx/policy/zz_shards_github_oracle_test.go"
trap 'rm -f "$test"' EXIT
cp "$here/github_oracle_test.go" "$test"
cd "$bx"
SHARDS_POLICY_OUT="$root/crates/shards/src/build/testdata/github-attestation.json" \
	go test -mod=vendor -count=1 -run '^TestShardsGithubOracle$' ./policy/
