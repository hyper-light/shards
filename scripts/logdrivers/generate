def unpack(b, i):
    """The MessagePack value at b[i], and where the next one starts: the forms an event
    holds."""
    t = b[i]
    if t <= 0x7f:
        return t, i + 1
    if 0x80 <= t <= 0x8f or t in (0xde, 0xdf):
        n, i = (t & 0x0f, i + 1) if t <= 0x8f else ((struct.unpack(">H", b[i+1:i+3])[0], i + 3) if t == 0xde else (struct.unpack(">I", b[i+1:i+5])[0], i + 5))
        m = {}
        for _ in range(n):
            k, i = unpack(b, i)
            v, i = unpack(b, i)
            m[k] = v
        return m, i
    if 0x90 <= t <= 0x9f or t in (0xdc, 0xdd):
        n, i = (t & 0x0f, i + 1) if t <= 0x9f else ((struct.unpack(">H", b[i+1:i+3])[0], i + 3) if t == 0xdc else (struct.unpack(">I", b[i+1:i+5])[0], i + 5))
        a = []
        for _ in range(n):
            v, i = unpack(b, i)
            a.append(v)
        return a, i
    if 0xa0 <= t <= 0xbf or t in (0xd9, 0xda, 0xdb):
        if t <= 0xbf:
            n, i = t & 0x1f, i + 1
        else:
            w = {0xd9: 1, 0xda: 2, 0xdb: 4}[t]
            n, i = int.from_bytes(b[i+1:i+1+w], "big"), i + 1 + w
        return b[i:i+n].decode(), i + n
    if t in (0xd0, 0xd1, 0xd2, 0xd3):
        w = {0xd0: 1, 0xd1: 2, 0xd2: 4, 0xd3: 8}[t]
        return ("int" + str(8 * w), int.from_bytes(b[i+1:i+1+w], "big", signed=True)), i + 1 + w
    if t == 0xd7:
        return ("ext" + str(b[i+1]), b[i+2:i+10].hex()), i + 10
    raise ValueError(f"MessagePack form {t:#x}")

