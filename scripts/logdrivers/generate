#!/bin/sh
# Regenerates what Docker's syslog, gelf, fluentd, journald and splunk log drivers send,
# and which of their options Docker takes (crates/shards/src/logging/testdata/syslog.json,
# gelf.json, fluentd.json, journald.json and splunk.json), which crates/shards/src/logging and its tests hold shards to (D163 to
# D165).
#
# In shards-dind (CONTAINER), capture.go listens on UDP, TCP and TLS ports and on a unix
# datagram and stream socket. Each case's container prints a line on stdout, one on
# stderr, and one of 40,000 bytes, which moby's copier cuts into parts. Every message
# Docker's driver sends is recorded, its time, host and process ID made placeholders.
# Then `docker create` with each option case says which Docker takes. Everything is made
# in a directory and under names of its own, removed after.
#
#   scripts/logdrivers/generate
set -eu

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
out="$root/crates/shards/src/logging/testdata/syslog.json"
gelf_out="$root/crates/shards/src/logging/testdata/gelf.json"
journald_out="$root/crates/shards/src/logging/testdata/journald.json"
splunk_out="$root/crates/shards/src/logging/testdata/splunk.json"
fluentd_out="$root/crates/shards/src/logging/testdata/fluentd.json"
container=${CONTAINER:-shards-dind}
image=alpine:3.22
work=$(mktemp -d)
dir=/root/shards-syslog-oracle-$$
name=shards-syslog-oracle-$$
# journald's entries go to the journal's socket, which the capture takes the place of: the
# probe container has no journal of its own, and keeps none of this run's.
journal=/run/systemd/journal/socket
journal_made=
cleanup() {
	rm -rf "$work"
	# Anchored, so that it matches the capture alone, not the shell that runs it.
	docker exec "$container" sh -c "pkill -f '^$dir/capture'; for c in \$(docker ps -aq --filter name=$name); do docker rm -f \$c; done; rm -rf $dir" >/dev/null 2>&1 || true
	if [ -n "$journal_made" ]; then
		docker exec "$container" rm -f "$journal" >/dev/null 2>&1 || true
	fi
}
trap cleanup EXIT

case $(uname -m) in
arm64 | aarch64) arch=arm64 ;;
x86_64 | amd64) arch=amd64 ;;
*)
	echo "unknown architecture $(uname -m)" >&2
	exit 1
	;;
esac
(cd "$here" && GOOS=linux GOARCH="$arch" CGO_ENABLED=0 go build -o "$work/capture" capture.go)
docker exec "$container" mkdir -p "$dir/cases" "$dir/gelf" "$dir/fluentd" "$dir/journald" "$dir/splunk"
docker cp "$work/capture" "$container:$dir/capture"
if docker exec "$container" test -e "$journal"; then
	echo "$container has $journal already: the capture takes the journal's place" >&2
	exit 1
fi
docker exec "$container" mkdir -p "$(dirname "$journal")"
journal_made=1
docker exec -d "$container" "$dir/capture" "$dir" "$journal"
until docker exec "$container" test -e "$dir/ready"; do sleep 0.2; done
docker exec "$container" docker version --format '{{.Server.Version}}' >"$work/version"

# What each case's container prints: a line on each stream, then one of 40,000 bytes.
print='echo out; echo err >&2; head -c 40000 /dev/zero | tr "\000" x; echo'
# Each case: its name, its transport's address, its format, its facility. A case is done
# once its messages are in: five datagrams, or its connection's end.
i=0
for transport in udp tcp tls unixgram unix; do
	case $transport in
	udp) address=udp://127.0.0.1:5514 ;;
	tcp) address=tcp://127.0.0.1:5515 ;;
	tls) address=tcp+tls://127.0.0.1:5516 ;;
	unixgram) address=unixgram://$dir/gram.sock ;;
	unix) address=unix://$dir/stream.sock ;;
	esac
	for format in unix rfc3164 rfc5424 rfc5424micro; do
		for facility in daemon local7; do
			# Every format on every transport, with its default facility; one other.
			[ "$facility" = local7 ] && [ "$format" != rfc5424 ] && continue
			i=$((i + 1))
			set -- --log-driver syslog --log-opt "syslog-address=$address" --log-opt tag=oracle \
				--log-opt "syslog-facility=$facility"
			[ "$format" = unix ] || set -- "$@" --log-opt "syslog-format=$format"
			[ "$transport" = tls ] && set -- "$@" --log-opt "syslog-tls-ca-cert=$dir/ca.pem"
			docker exec "$container" docker run --rm --name "$name-$i" "$@" "$image" sh -c "$print" >/dev/null 2>&1
			case $transport in
			udp | unixgram) want=5 ;;
			*) want=1 ;;
			esac
			until [ "$(docker exec "$container" sh -c "ls $dir/out | wc -l")" -ge "$want" ]; do sleep 0.1; done
			docker exec "$container" sh -c "mkdir $dir/cases/$transport-$format-$facility && mv $dir/out/* $dir/cases/$transport-$format-$facility/"
		done
	done
done
# gelf: UDP, gzipped (its default), zlib'd and not, the last in chunks; and TCP. A label
# asked for, as the container's fields go with it.
for case in udp-gzip udp-zlib udp-none tcp-none; do
	transport=${case%%-*}
	compression=${case#*-}
	i=$((i + 1))
	case $transport in
	udp) address=udp://127.0.0.1:5514 ;;
	tcp) address=tcp://127.0.0.1:5515 ;;
	esac
	set -- --log-driver gelf --log-opt "gelf-address=$address" --log-opt tag=oracle \
		--log-opt labels=a --label a=b
	[ "$transport" = udp ] && set -- "$@" --log-opt "gelf-compression-type=$compression"
	docker exec "$container" docker run --rm --name "$name-$i" "$@" "$image" sh -c "$print" >/dev/null 2>&1
	if [ "$transport" = udp ]; then
		# Its datagrams are sent as its run ends: those in, and no more coming.
		sleep 1
	else
		until [ "$(docker exec "$container" sh -c "ls $dir/out | wc -l")" -ge 1 ]; do sleep 0.1; done
	fi
	docker exec "$container" sh -c "mkdir $dir/gelf/$case && mv $dir/out/* $dir/gelf/$case/"
done
# fluentd: TCP in whole seconds and to the nanosecond, and a unix socket; its record's
# label asked for. Its driver dials as its container starts, and sends as it runs.
for case in tcp-seconds tcp-nanoseconds unix-seconds; do
	transport=${case%%-*}
	i=$((i + 1))
	case $transport in
	tcp) address=tcp://127.0.0.1:5515 ;;
	unix) address=unix://$dir/stream.sock ;;
	esac
	set -- --log-driver fluentd --log-opt "fluentd-address=$address" --log-opt tag=oracle \
		--log-opt labels=a --label a=b
	[ "$case" = tcp-nanoseconds ] && set -- "$@" --log-opt fluentd-sub-second-precision=true
	docker exec "$container" docker run --rm --name "$name-$i" "$@" "$image" sh -c "$print" >/dev/null 2>&1
	until [ "$(docker exec "$container" sh -c "ls $dir/out | wc -l")" -ge 1 ]; do sleep 0.1; done
	docker exec "$container" sh -c "mkdir $dir/fluentd/$case && mv $dir/out/* $dir/fluentd/$case/"
done
# journald: a line on each stream and one of 40,000 bytes in parts, its tag the short ID;
# a tag and attributes, among them one journald drops (a digit first), one named as the
# driver's own MESSAGE and one as the container's CONTAINER_NAME, and an environment
# variable's; and an entry longer than a datagram, which go-systemd passes in a file: its
# labels together past the most a datagram takes (twice wmem_max, as Linux doubles a send
# buffer), each of 60,000 bytes, as Docker's CLI reads no line of a label file past 64 KiB
# (bufio.Scanner). Its entries are sent as its run runs.
wmem_max=$(docker exec "$container" cat /proc/sys/net/core/wmem_max)
labels=$(((wmem_max * 2 + 65536) / 60000 + 1))
: >"$work/big.labels"
for n in $(seq "$labels"); do
	{
		printf 'big%s=' "$n"
		head -c 60000 /dev/zero | tr '\000' y
		printf '\n'
	} >>"$work/big.labels"
done
docker cp "$work/big.labels" "$container:$dir/big.labels"
for case in streams attributes large; do
	i=$((i + 1))
	set -- --log-driver journald
	command=$print
	want=5
	case $case in
	attributes)
		set -- "$@" --log-opt 'tag={{.Name}}' --log-opt labels=a.b,_c,1d,message,container.name \
			--label a.b=1 --label _c=2 --label 1d=3 --label message=4 --label container.name=5 \
			--log-opt env=E_F --env E_F=6
		command='echo one'
		want=1
		;;
	large)
		set -- "$@" --label-file "$dir/big.labels" --log-opt labels-regex=^big
		command='echo one'
		want=1
		;;
	esac
	docker exec "$container" docker run --rm --name "$name-$i" "$@" "$image" sh -c "$command" >/dev/null 2>&1
	until [ "$(docker exec "$container" sh -c "ls $dir/out | wc -l")" -ge "$want" ]; do sleep 0.1; done
	docker exec "$container" sh -c "mkdir $dir/journald/$case && mv $dir/out/* $dir/journald/$case/"
done
# splunk: its formats, inline (its default), json and raw; gzipped at a level; over HTTPS,
# its CA given and the name its certificate is for; its source, sourcetype and index, and
# indexer acknowledgment's channel; its tag left out. Lines that are JSON and not, HTML's
# characters, one of whitespace, and one of 40,000 bytes in parts. Its driver asks HEC
# whether it is there (OPTIONS) as its container starts, and posts its events every 5 s
# or as its run ends.
splunk_print='echo out; echo err >&2; echo "{\"a\": [1, 2], \"b\": \"<&>\"}"; echo "  "; echo 12; head -c 40000 /dev/zero | tr "\000" x; echo'
token=00000000-0000-0000-0000-000000000000
for case in inline json raw gzip https fields notag; do
	i=$((i + 1))
	set -- --log-driver splunk --log-opt splunk-token=$token --log-opt labels=a --label a=b
	case $case in
	https) set -- "$@" --log-opt splunk-url=https://127.0.0.1:8089 --log-opt "splunk-capath=$dir/ca.pem" --log-opt splunk-caname=localhost ;;
	*) set -- "$@" --log-opt splunk-url=http://127.0.0.1:8088 ;;
	esac
	case $case in
	json | raw) set -- "$@" --log-opt "splunk-format=$case" ;;
	gzip) set -- "$@" --log-opt splunk-gzip=true --log-opt splunk-gzip-level=9 ;;
	fields) set -- "$@" --log-opt splunk-source=src --log-opt splunk-sourcetype=st --log-opt splunk-index=main --log-opt splunk-index-acknowledgment=true ;;
	notag) set -- "$@" --log-opt tag= ;;
	esac
	docker exec "$container" docker run --rm --name "$name-$i" "$@" "$image" sh -c "$splunk_print" >/dev/null 2>&1
	# Its OPTIONS, then its posts: those in once its run has ended, and no more coming.
	until [ "$(docker exec "$container" sh -c "ls $dir/out | wc -l")" -ge 2 ]; do sleep 0.1; done
	sleep 1
	docker exec "$container" sh -c "mkdir $dir/splunk/$case && mv $dir/out/* $dir/splunk/$case/"
done
docker exec "$container" tar -C "$dir/cases" -c . | tar -x -C "$work"
mkdir "$work/splunk"
docker exec "$container" tar -C "$dir/splunk" -c . | tar -x -C "$work/splunk"
mkdir "$work/journald"
docker exec "$container" tar -C "$dir/journald" -c . | tar -x -C "$work/journald"
mkdir "$work/fluentd"
docker exec "$container" tar -C "$dir/fluentd" -c . | tar -x -C "$work/fluentd"
mkdir "$work/gelf"
docker exec "$container" tar -C "$dir/gelf" -c . | tar -x -C "$work/gelf"

# Which options Docker takes, as `docker create` answers them: none dials.
i=0
for opt in \
	"syslog-address=udp://127.0.0.1:5514" \
	"syslog-address=tcp://127.0.0.1" \
	"syslog-address=tcp+tls://127.0.0.1:5516" \
	"syslog-address=unix://$dir/stream.sock" \
	"syslog-address=unixgram://$dir/gram.sock" \
	"syslog-address=unix://$dir/missing.sock" \
	"syslog-address=unix://host$dir/stream.sock" \
	"syslog-address=http://127.0.0.1:514" \
	"syslog-address=udp://127.0.0.1:port" \
	"syslog-address=udp://::1" \
	"syslog-address=udp://[::1]" \
	"syslog-address=127.0.0.1:514" \
	"syslog-facility=local0" \
	"syslog-facility=23" \
	"syslog-facility=24" \
	"syslog-facility=bogus" \
	"syslog-format=rfc5424micro" \
	"syslog-format=bogus" \
	"syslog-tls-skip-verify=true" \
	"syslog-color=red" \
	"max-size=10m" \
	"cache-max-size=10m" \
	"cache-disabled=maybe" \
	"mode=non-blocking" \
	"tag={{.Name}}"; do
	i=$((i + 1))
	if said=$(docker exec "$container" docker create --name "$name-o$i" --log-driver syslog --log-opt "$opt" "$image" true 2>&1); then
		docker exec "$container" docker rm "$name-o$i" >/dev/null 2>&1 || true
		printf '%s\t\n' "$opt" >>"$work/options"
	else
		printf '%s\t%s\n' "$opt" "$(printf '%s' "$said" | tr '\n' ' ')" >>"$work/options"
	fi
done
# fluentd's: each case its options, separated by |.
for opts in \
	"" \
	"fluentd-address=127.0.0.1:24224" \
	"fluentd-address=tcp://127.0.0.1" \
	"fluentd-address=tls://127.0.0.1:24224" \
	"fluentd-address=unix:///tmp/f.sock" \
	"fluentd-address=unix://" \
	"fluentd-address=http://127.0.0.1:24224" \
	"fluentd-address=tcp://127.0.0.1:24224/path" \
	"fluentd-address=tcp://127.0.0.1:70000" \
	"fluentd-async=true" \
	"fluentd-async=maybe" \
	"fluentd-buffer-limit=8m" \
	"fluentd-buffer-limit=lots" \
	"fluentd-retry-wait=500ms" \
	"fluentd-retry-wait=soon" \
	"fluentd-max-retries=3" \
	"fluentd-max-retries=-1" \
	"fluentd-max-retries=4294967296" \
	"fluentd-request-ack=true" \
	"fluentd-sub-second-precision=true" \
	"fluentd-write-timeout=2s" \
	"fluentd-write-timeout=-1s" \
	"fluentd-read-timeout=2s" \
	"fluentd-async-reconnect-interval=1s" \
	"fluentd-async-reconnect-interval=20s" \
	"fluentd-color=red"; do
	i=$((i + 1))
	set --
	old_ifs=$IFS
	IFS='|'
	for o in $opts; do set -- "$@" --log-opt "$o"; done
	IFS=$old_ifs
	if said=$(docker exec "$container" docker create --name "$name-o$i" --log-driver fluentd "$@" "$image" true 2>&1); then
		docker exec "$container" docker rm "$name-o$i" >/dev/null 2>&1 || true
		printf '%s\t\n' "$opts" >>"$work/fluentd-options"
	else
		printf '%s\t%s\n' "$opts" "$(printf '%s' "$said" | tr '\n' ' ')" >>"$work/fluentd-options"
	fi
done
# gelf's: each case its options, separated by |.
for opts in \
	"" \
	"gelf-address=udp://127.0.0.1:12201" \
	"gelf-address=tcp://127.0.0.1:12201" \
	"gelf-address=http://127.0.0.1:12201" \
	"gelf-address=udp://127.0.0.1" \
	"gelf-address=udp://127.0.0.1:12201|gelf-compression-type=zlib" \
	"gelf-address=udp://127.0.0.1:12201|gelf-compression-type=lz4" \
	"gelf-address=tcp://127.0.0.1:12201|gelf-compression-type=gzip" \
	"gelf-address=udp://127.0.0.1:12201|gelf-compression-level=9" \
	"gelf-address=udp://127.0.0.1:12201|gelf-compression-level=-1" \
	"gelf-address=udp://127.0.0.1:12201|gelf-compression-level=10" \
	"gelf-address=tcp://127.0.0.1:12201|gelf-tcp-max-reconnect=5" \
	"gelf-address=tcp://127.0.0.1:12201|gelf-tcp-max-reconnect=-1" \
	"gelf-address=udp://127.0.0.1:12201|gelf-tcp-max-reconnect=5" \
	"gelf-address=tcp://127.0.0.1:12201|gelf-tcp-reconnect-delay=2" \
	"gelf-address=udp://127.0.0.1:12201|gelf-color=red" \
	"gelf-address=udp://127.0.0.1:12201|tag={{.Name}}"; do
	i=$((i + 1))
	set --
	old_ifs=$IFS
	IFS='|'
	for o in $opts; do set -- "$@" --log-opt "$o"; done
	IFS=$old_ifs
	if said=$(docker exec "$container" docker create --name "$name-o$i" --log-driver gelf "$@" "$image" true 2>&1); then
		docker exec "$container" docker rm "$name-o$i" >/dev/null 2>&1 || true
		printf '%s\t\n' "$opts" >>"$work/gelf-options"
	else
		printf '%s\t%s\n' "$opts" "$(printf '%s' "$said" | tr '\n' ' ')" >>"$work/gelf-options"
	fi
done

# journald's: each case its options, separated by |. None dials the journal.
for opts in \
	"" \
	"tag={{.Name}}" \
	"labels=a|labels-regex=^a|env=B|env-regex=^B" \
	"max-size=10m" \
	"journald-color=red" \
	"cache-disabled=true" \
	"mode=non-blocking"; do
	i=$((i + 1))
	set --
	old_ifs=$IFS
	IFS='|'
	for o in $opts; do set -- "$@" --log-opt "$o"; done
	IFS=$old_ifs
	if said=$(docker exec "$container" docker create --name "$name-o$i" --log-driver journald "$@" "$image" true 2>&1); then
		docker exec "$container" docker rm "$name-o$i" >/dev/null 2>&1 || true
		printf '%s\t\n' "$opts" >>"$work/journald-options"
	else
		printf '%s\t%s\n' "$opts" "$(printf '%s' "$said" | tr '\n' ' ')" >>"$work/journald-options"
	fi
done

# splunk's: each case its options, separated by |. None posts: verify-connection off.
for opts in \
	"" \
	"splunk-url=http://127.0.0.1:8088" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false" \
	"splunk-url=ftp://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false" \
	"splunk-url=http://127.0.0.1:8088/path|splunk-token=t|splunk-verify-connection=false" \
	"splunk-url=http://127.0.0.1:8088/?q=1|splunk-token=t|splunk-verify-connection=false" \
	"splunk-url=http://127.0.0.1:8088/|splunk-token=t|splunk-verify-connection=false" \
	"splunk-url=127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false|splunk-format=xml" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false|splunk-gzip=maybe" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false|splunk-gzip-level=10" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false|splunk-gzip-level=-2" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false|splunk-insecureskipverify=true" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false|splunk-capath=/nonexistent" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false|splunk-index-acknowledgment=yes" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=maybe" \
	"splunk-url=http://127.0.0.1:8088|splunk-token=t|splunk-verify-connection=false|splunk-color=red"; do
	i=$((i + 1))
	set --
	old_ifs=$IFS
	IFS='|'
	for o in $opts; do set -- "$@" --log-opt "$o"; done
	IFS=$old_ifs
	# Its options are checked as its container is made, and its driver made as it
	# starts: a run says both.
	if said=$(docker exec "$container" docker run --rm --name "$name-o$i" --log-driver splunk "$@" "$image" true 2>&1); then
		printf '%s\t\n' "$opts" >>"$work/splunk-options"
	else
		printf '%s\t%s\n' "$opts" "$(printf '%s' "$said" | tr '\n' ' ')" >>"$work/splunk-options"
	fi
done

python3 -I - "$work" "$dir" "$out" "$gelf_out" "$fluentd_out" "$journald_out" "$name" "$splunk_out" <<'EOF'
import gzip, json, os, re, struct, sys, zlib

work, dind, out, gelf_out, fluentd_out, journald_out, name, splunk_out = sys.argv[1:9]
version = open(os.path.join(work, "version")).read().strip()
STAMP = r"[A-Z][a-z]{2} [ \d]\d \d\d:\d\d:\d\d"
FORMATS = {
    "unix": re.compile(rf"^<(\d+)>({STAMP}) (\S*)\[(\d+)\]: (.*)\n$", re.S),
    "rfc3164": re.compile(rf"^<(\d+)>({STAMP}) (\S*) (\S*)\[(\d+)\]: (.*)\n$", re.S),
    "rfc5424": re.compile(r"^<(\d+)>1 (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:Z|[+-]\d\d:\d\d)) (\S*) (\S+) (\d+) (\S+) - (.*)\n$", re.S),
    "rfc5424micro": re.compile(r"^<(\d+)>1 (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{6}(?:Z|[+-]\d\d:\d\d)) (\S*) (\S+) (\d+) (\S+) - (.*)\n$", re.S),
}

def split(transport, fmt, files):
    """The messages of a case, as its transport frames them."""
    blobs = [open(f, "rb").read() for f in files]
    if transport in ("udp", "unixgram"):
        return blobs, "datagram"
    data = b"".join(blobs)
    if transport == "tls" and fmt.startswith("rfc5424"):
        msgs = []
        while data:
            n, rest = data.split(b" ", 1)
            msgs.append(rest[: int(n)])
            data = rest[int(n):]
        return msgs, "octet-counted"
    return [m + b"\n" for m in data.split(b"\n")[:-1]], "newline"

def content(c):
    """A message's content, a run of x by its length."""
    return {"x": len(c)} if c and set(c) == {"x"} else c

cases = []
for case in sorted(os.listdir(work)):
    path = os.path.join(work, case)
    if not os.path.isdir(path) or case in ("gelf", "fluentd", "journald", "splunk"):
        continue
    transport, fmt, facility = case.split("-")
    files = [os.path.join(path, f) for f in sorted(os.listdir(path))]
    msgs, framing = split(transport, fmt, files)
    out_msgs = []
    for m in msgs:
        text = m.decode()
        g = FORMATS[fmt].match(text)
        assert g, (case, text[:120])
        if fmt == "unix":
            pri, _, tag, _, body = g.groups()
            head = f"<{pri}>{{stamp}} {tag}[{{pid}}]: "
        elif fmt == "rfc3164":
            pri, _, _, tag, _, body = g.groups()
            head = f"<{pri}>{{stamp}} {{host}} {tag}[{{pid}}]: "
        else:
            pri, _, _, app, _, msgid, body = g.groups()
            head = f"<{pri}>1 {{time}} {{host}} {app} {{pid}} {msgid} - "
        out_msgs.append({"head": head, "content": content(body)})
    # Docker sends each stream's messages from a goroutine of its own: their order between
    # the streams is not Docker's to keep, so each stream's are kept in theirs, stderr's
    # first (a stable sort by their heads, which differ by severity alone).
    out_msgs.sort(key=lambda m: m["head"])
    cases.append({
        "transport": transport,
        "format": fmt,
        "facility": facility,
        "framing": framing,
        "messages": out_msgs,
    })

