def journal_fields(data):
    """An entry's fields, in order, as journald reads the native protocol."""
    out, i = [], 0
    while i < len(data):
        j = min(k for k in (data.find(b"\n", i), data.find(b"=", i)) if k != -1)
        field = data[i:j].decode()
        if data[j:j + 1] == b"=":
            nl = data.index(b"\n", j)
            value, i = data[j + 1:nl], nl + 1
        else:
            n = struct.unpack("<Q", data[j + 1:j + 9])[0]
            value, i = data[j + 9:j + 9 + n], j + 10 + n
        out.append((field, value.decode()))
    return out

RFC3339NANO = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d*[1-9])?Z$")

def journal_normal(fields):
    """An entry's fields sorted by name, the container's own values, its epoch, a part's
    ID and its time made placeholders, and a run of one letter its length."""
    full = dict(fields)["CONTAINER_ID_FULL"]
    def value(field, v):
        if field == "CONTAINER_ID_FULL":
            return "{id}"
        if v == full[:12]:
            return "{id12}"
        if field == "CONTAINER_LOG_EPOCH":
            assert re.fullmatch(r"[0-9a-f]{64}", v), v
            return "{epoch}"
        if field == "CONTAINER_PARTIAL_ID":
            return "{partial}"
        if field == "SYSLOG_TIMESTAMP":
            assert RFC3339NANO.match(v), v
            return "{time}"
        # Its place among its log's entries, which each stream's goroutine in Docker's
        # copier reaches its driver in no set order: each case's are 1 to its count.
        if field == "CONTAINER_LOG_ORDINAL":
            return "{ordinal}"
        if re.fullmatch(re.escape(name) + r"-\d+", v):
            return "{name}"
        if len(v) > 1 and len(set(v)) == 1 and v[0] in "xy":
            return {v[0]: len(v)}
        return v
    return sorted(([f, value(f, v)] for f, v in fields), key=lambda f: f[0])

