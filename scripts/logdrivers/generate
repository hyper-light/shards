HOST = None
def splunk_normal(text):
    """An event as Docker posted it, its host, time and tag made placeholders."""
    global HOST
    m = json.loads(text)
    HOST = HOST or m["host"]
    assert m["host"] == HOST, m
    assert re.fullmatch(r"\d+\.\d{6}", m["time"]), m
    text = text.replace(json.dumps(m["host"]), '"{host}"', 1).replace(json.dumps(m["time"]), '"{time}"', 1)
    return re.sub(r"\b[0-9a-f]{12}\b", "{id12}", text)

def split_events(body):
    """A post's events, one JSON object after another."""
    out, depth, start, in_str, esc = [], 0, 0, False, False
    for i, c in enumerate(body):
        if in_str:
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                out.append(body[start:i + 1])
                start = i + 1
    assert body[start:] == "", body[start:start + 80]
    return out

def stderr_event(e):
    """Whether an event is the one line the oracle's run writes to stderr, `err`."""
    event = json.loads(e)["event"]
    if isinstance(event, dict):
        return event["source"] == "stderr"
    return event == "err" or event.endswith(" err")

