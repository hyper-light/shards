#!/bin/sh
# OPA v1.14.1's numbers for crates/rego/benches/policy.rs's cases, OPA set up as
# scripts/rego/generate sets it up (buildx v0.37.1's policy/builtins.go and
# policy/builtins.rego, fetched at that tag and checked against their SHA-256), each
# policy run as buildx runs one per source it checks (scripts/rego/bench_test.go).
#
#   scripts/rego/bench-opa [CASES.json [N]]
#
# CASES.json defaults to crates/rego/benches/policies/cases.json, N to 100.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
cases=${1:-$root/crates/rego/benches/policies/cases.json}
cases=$(cd "$(dirname "$cases")" && pwd)/$(basename "$cases")
n=${2:-100}
tag=v0.37.1
builtins_go=3864f6ebfc6eb97ddbc05bef8f380db30b54a81b4359cad23ba5bf06f56f26c2
builtins_rego=8990a878e2fa88b07ff2da57f2476bb79953d50f17823298d541f1d86761c8e2
case $(go env GOVERSION) in
go1.26 | go1.26.*) ;;
*)
	echo "Go 1.26 builds buildx $tag; this is $(go env GOVERSION)" >&2
	exit 1
	;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fetch() {
	curl -fsSL -A shards-dev -o "$work/$1" "https://raw.githubusercontent.com/docker/buildx/$tag/policy/$1"
	if [ "$(shasum -a 256 "$work/$1" | cut -d' ' -f1)" != "$2" ]; then
		echo "buildx $tag policy/$1 is not the file pinned ($2)" >&2
		exit 1
	fi
}
fetch builtins.go "$builtins_go"
fetch builtins.rego "$builtins_rego"
sed -i.orig 's/^package policy$/package oracle/' "$work/builtins.go"
rm "$work/builtins.go.orig"
printf 'module shards.oracle\n\ngo 1.26\n' >"$work/go.mod"
cp "$here/oracle_test.go" "$here/bench_test.go" "$work/"
cd "$work"
go get github.com/open-policy-agent/opa@v1.14.1 >/dev/null 2>&1
go mod tidy >/dev/null 2>&1
echo "host: $(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -m); os: $(uname -sr); $(go env GOVERSION); load: $(uptime | sed 's/.*load averages*: //')"
SHARDS_BENCH_POLICIES="$cases" SHARDS_BENCH_N="$n" \
	go test -count=1 -timeout 60m -run '^TestShardsBench$' -v . | grep '^{'
