#!/bin/sh
# Regenerates crates/cmdline/tests/format.json: what docker/cli v29.8.1's own formatter
# code writes for `ps`, `images`, `stats`, `system df` and `history` of the fixtures in
# container_test.go and history_test.go, with each format of their corpus, which
# crates/cmdline/tests/format.rs expects shards_cmdline::format to write byte for byte.
# The tests run inside docker/cli's packages, built by the Go release that builds it
# (1.26), through its with-go-mod.sh, so they import exactly the packages the CLI
# vendors. TZ gives the local zone times are printed in; the cases record it.
#
#   scripts/format/generate [DOCKER_CLI_CHECKOUT]
set -eu

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
tag=v29.8.1
commit=4a63305d74332de5ceba7fcbccbc3cbb7412f5ba
cli=${1:-}
if [ -z "$cli" ]; then
	cli=$(mktemp -d)
	trap 'rm -rf "$cli"' EXIT
	git clone --quiet --depth 1 --branch "$tag" https://github.com/docker/cli "$cli"
fi
if [ "$(git -C "$cli" rev-parse HEAD)" != "$commit" ]; then
	echo "$cli is not docker/cli $tag ($commit)" >&2
	exit 1
fi
case $(go env GOVERSION) in
go1.26 | go1.26.*) ;;
*)
	echo "Go 1.26 builds docker/cli $tag; this is $(go env GOVERSION)" >&2
	exit 1
	;;
esac

part=$(mktemp)
cp "$here/container_test.go" "$cli/cli/command/container/zz_shards_format_test.go"
cp "$here/history_test.go" "$cli/cli/command/image/zz_shards_format_test.go"
cleanup() {
	rm -f "$part" "$cli/cli/command/container/zz_shards_format_test.go" \
		"$cli/cli/command/image/zz_shards_format_test.go"
}
trap 'cleanup; [ -z "${1:-}" ] && rm -rf "$cli"' EXIT
cd "$cli"
export TZ=Asia/Kolkata
SHARDS_FORMAT_PART="$part" \
	./scripts/with-go-mod.sh go test -mod=vendor -count=1 -run '^TestShardsFormat$' ./cli/command/container/
SHARDS_FORMAT_PART="$part" SHARDS_FORMAT_OUT="$root/crates/cmdline/tests/format.json" \
	./scripts/with-go-mod.sh go test -mod=vendor -count=1 -run '^TestShardsFormatHistory$' ./cli/command/image/
