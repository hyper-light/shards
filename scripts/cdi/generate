#!/bin/sh
# Regenerates crates/shards/src/build/testdata/cdi-parsed.json: what CDI v1.1.0's
# ParseSpec makes of each spec of testdata/cdi-specs.json, run by Go 1.25.8 (D96).
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp "$here/oracle/main.go" "$work/main.go"
cd "$work"
cat >go.mod <<'MOD'
module shards.dev/cdi-oracle

go 1.25

require tags.cncf.io/container-device-interface v1.1.0
MOD
GOTOOLCHAIN=go1.25.8 GOFLAGS=-mod=mod go mod tidy >/dev/null 2>&1
GOTOOLCHAIN=go1.25.8 GOFLAGS=-mod=mod go run . "$root/crates/shards/src/build/testdata/cdi-specs.json" "$root/crates/shards/src/build/testdata/cdi-parsed.json"
