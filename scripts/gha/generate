#!/bin/sh
# Regenerates crates/shards/src/build/testdata/gha.json: every request go-actions-cache
# (BuildKit v0.28.1's pin) sends to GitHub's cache service v2 and its blob storage for
# what BuildKit's gha cache does, run by Go 1.25.8 (D90).
#
#   scripts/gha/generate
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp "$here/oracle/main.go" "$work/main.go"
cd "$work"
cat >go.mod <<'MOD'
module shards.dev/gha-oracle

go 1.25

require github.com/tonistiigi/go-actions-cache v0.0.0-20260120203934-54bc28c26fd2
MOD
GOTOOLCHAIN=go1.25.8 GOFLAGS=-mod=mod go mod tidy >/dev/null 2>&1
GOTOOLCHAIN=go1.25.8 GOFLAGS=-mod=mod go run . "$root/crates/shards/src/build/testdata/gha.json"
