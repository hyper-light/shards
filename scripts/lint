#!/bin/sh
# Lints the workspace for every CI target from this one host (CLAUDE.md), after CI's
# format check. The C in aws-lc-sys needs a compiler per target:
# - Linux (glibc and musl): zig.
# - Windows: cargo-xwin, which drives clang-cl with Microsoft's CRT and SDK. clang-cl and
#   llvm-lib come from LLVM's bin directory, and Windows x64 also needs NASM.
#
#   scripts/lint [TARGET...]
set -eu
# Clippy checks code; it links nothing, so `shards` need not carry its VM and network
# processes built for each target (crates/shards/build.rs).
export SHARDS_HELPERS=skip

root=$(cd "$(dirname "$0")/.." && pwd)
all=$(cat "$root/resources/supported-targets.txt")
llvm=${LLVM_BIN:-$(brew --prefix llvm 2>/dev/null || true)/bin}

echo "== format"
cargo fmt --all --check

echo "== durable writes"
# Every durable write is shards_durable's, declared to whoever follows its process (D286):
# clippy refuses the OS's syncs elsewhere (clippy.toml), but F_FULLFSYNC is a constant, which
# clippy cannot name, so code outside crates/durable that names it is refused here. Comments
# may name it.
status=0
git -C "$root" grep --untracked -n -E '^([^/]|/[^/])*F_FULLFSYNC' -- crates ':!crates/durable' || status=$?
case $status in
1) ;;
0) echo "F_FULLFSYNC outside crates/durable: make the write durable with shards_durable (D286)" >&2; exit 1 ;;
*) echo "searching crates/ for F_FULLFSYNC failed ($status)" >&2; exit 1 ;;
esac

echo "== paths"
# Every path git tracks, or would add, fits a Windows checkout without core.longpaths, which
# Windows' git and cargo leave off. Cargo checks a git dependency out with libgit2, which
# refuses a path past MAX_PATH, 260 characters (libgit2 1.9.6, cargo 1.99's: fs_path.c
# validate_length), under the longest prefix a checkout of shards has:
# C:\Users\<user>\.cargo\git\checkouts\shards-<16 hex>\<id>\, 116 characters with a user name
# of 20, the most Windows allows (USER_INFO_1), and an id of 40 hex digits, the most cargo's 7
# grows to while they are ambiguous (sources/git/utils.rs to_short_id). 260 - 116 = 144. It
# also looks for .gitattributes in every directory it checks a file out into, refusing that
# path past MAX_PATH too (attr.c collect_attr_files, attrcache.c attr_cache_lookup): a
# directory takes 144 - 15 = 129 at most, so each file's is counted as DIR/.gitattributes.
# Git for Windows writes a file of 259 characters and a directory of 247 at most
# (compat/mingw.c handle_long_path, mingw_mkdir): from the longest clone prefix, kiln's
# runner's C:\Users\<user>\AppData\Local\kiln\agent\work\w\<8 hex>\shards\ (78 with a user
# name of 20), a path of 144 reaches 222 and its directory 207. Counted in UTF-16 code units,
# as Windows counts them.
bound=144
long=$(perl -CS -e '
	my ($root, $bound) = @ARGV;
	open(my $git, "-|", "git", "-C", $root, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
		or die "git ls-files: $!\n";
	binmode($git, ":encoding(UTF-8)");
	local $/ = "\0";
	my %dirs;
	while (my $path = <$git>) {
		chomp $path;
		my @probes = ($path);
		push @probes, "$1/.gitattributes" if $path =~ m{^(.+)/[^/]+$} && !$dirs{$1}++;
		for my $probe (@probes) {
			my $n = length($probe) + (() = $probe =~ /[^\x{0}-\x{FFFF}]/g);
			print "$probe: $n\n" if $n > $bound;
		}
	}
	close($git) or die "git ls-files failed\n";
' "$root" "$bound")
if [ -n "$long" ]; then
	printf '%s\n' "$long" >&2
	printf '%s\n' "paths past $bound characters, the most a Windows checkout holds without core.longpaths:" \
		'libgit2'"'"'s MAX_PATH (260) less cargo'"'"'s checkout C:\Users\<user>\.cargo\git\checkouts\shards-<16 hex>\<id>\' \
		'(116, a user name of 20 and an id of 40), counting the .gitattributes libgit2 looks for in each directory.' \
		'Shorten them; a measurement folder keeps the names its records use in renamed.tsv.' >&2
	exit 1
fi

for target in ${*:-$all}; do
	case " $(printf '%s' "$all" | tr '\n' ' ') " in
		*" $target "*) ;;
		*) echo "unsupported target: $target" >&2; exit 1 ;;
	esac
	var=$(printf %s "$target" | tr - _)
	echo "== $target"
	case $target in
	*-linux-gnu | *-linux-musl)
		env "CC_$var=$root/scripts/zig-cc" "AR_$var=$root/scripts/zig-ar" \
			ZIG_TARGET="${target%%-*}-linux-${target##*-}" \
			cargo clippy --workspace --all-targets --target "$target" -- -D warnings
		# The GPU's renderer on Linux with glibc (D201), as on macOS below.
		case $target in
		*-linux-gnu)
			env "CC_$var=$root/scripts/zig-cc" "AR_$var=$root/scripts/zig-ar" \
				ZIG_TARGET="${target%%-*}-linux-gnu" \
				cargo clippy -p shards-vmm --features gpu --all-targets --target "$target" -- -D warnings
			;;
		esac
		;;
	*-windows-msvc)
		PATH="$llvm:$PATH" cargo xwin clippy --workspace --all-targets --target "$target" -- -D warnings
		# The GPU's renderer on x86_64 Windows (D202), as on macOS below.
		if [ "$target" = x86_64-pc-windows-msvc ]; then
			PATH="$llvm:$PATH" cargo xwin clippy -p shards-vmm --features gpu --all-targets --target "$target" -- -D warnings
		fi
		;;
	*)
		cargo clippy --workspace --all-targets --target "$target" -- -D warnings
		# The GPU's renderer (D144): behind vmm's `gpu` feature, the GPU's VM process's alone.
		if [ "$target" = aarch64-apple-darwin ]; then
			cargo clippy -p shards-vmm --features gpu --all-targets --target "$target" -- -D warnings
		fi
		;;
	esac
done
