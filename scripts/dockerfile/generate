#!/bin/sh
# Regenerates what crates/dockerfile takes from BuildKit's Dockerfile frontend, from
# moby/buildkit dockerfile/1.27.1 built by the Go its go.mod names:
# - crates/dockerfile/testdata/buildkit/, BuildKit's parser test files and lexer tables,
#   copied unmodified under its Apache-2.0 licence;
# - crates/dockerfile/testdata/parse.json and lex.json, what BuildKit's parser and lexer
#   make of them and of crates/dockerfile/testdata/corpus and lex-cases.json, which the
#   crate's tests expect byte for byte (oracle/main.go);
# - crates/dockerfile/testdata/instructions.json and plan.json, the typed instructions and
#   the build plan (Dockerfile2LLB's graph, image config and warnings, with the fake base
#   images of images.json) BuildKit makes of the corpus;
# - crates/dockerfile/testdata/configs-answers.json, what Go's encoding/json makes of each
#   image config in configs.json, read into BuildKit's DockerOCIImage and written back;
# - crates/dockerfile/testdata/sizes-answers.json and urls-answers.json, what go-units,
#   net/url and BuildKit's git URL parsing make of sizes.json and urls.json;
# - crates/dockerfile/src/tables.rs, Go's character classes the parser and lexer use.
#
#   scripts/dockerfile/generate [BUILDKIT_CHECKOUT]
set -eu

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
data="$root/crates/dockerfile/testdata"
tag=dockerfile/1.27.1
commit=08f4630c67a49ff3158f218e99fd93ad97a90747
bk=${1:-}
if [ -z "$bk" ]; then
	bk=$(mktemp -d)
	trap 'rm -rf "$bk"' EXIT
	git clone --quiet --depth 1 --branch "$tag" https://github.com/moby/buildkit "$bk"
fi
if [ "$(git -C "$bk" rev-parse HEAD)" != "$commit" ]; then
	echo "$bk is not moby/buildkit $tag ($commit)" >&2
	exit 1
fi

rm -rf "$data/buildkit"
mkdir -p "$data/buildkit/shell"
cp -R "$bk/frontend/dockerfile/parser/testfiles" "$data/buildkit/parser"
cp -R "$bk/frontend/dockerfile/parser/testfiles-negative" "$data/buildkit/parser-negative"
cp "$bk/frontend/dockerfile/shell/envVarTest" "$bk/frontend/dockerfile/shell/wordsTest" "$data/buildkit/shell/"
cp "$bk/LICENSE" "$data/buildkit/LICENSE"
cat >"$data/buildkit/README.md" <<EOF
# BuildKit's parser and lexer test data

\`parser/\`, \`parser-negative/\` and \`shell/\` are moby/buildkit's
\`frontend/dockerfile/parser/testfiles\`, \`testfiles-negative\` and \`shell\`'s
\`envVarTest\` and \`wordsTest\` at $tag ($commit), unmodified, under BuildKit's
Apache-2.0 licence in \`LICENSE\`. Regenerate with \`scripts/dockerfile/generate\`.
EOF

mkdir -p "$bk/shards-oracle"
cp "$here/oracle/main.go" "$bk/shards-oracle/main.go"
cleanup() { rm -rf "$bk/shards-oracle"; }
trap 'cleanup; [ -z "${1:-}" ] && rm -rf "$bk"' EXIT
(cd "$bk" && go run -mod=vendor ./shards-oracle "$data")
