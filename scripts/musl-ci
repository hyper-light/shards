#!/bin/sh
# CI's musl jobs, inside their pinned rust:alpine image on the runner's own architecture
# (.github/workflows/ci.yml, `musl`): lints, tests and builds $TARGET. With MUSL_CI=test it
# runs the tests alone; with MUSL_CI=release (CI's other musl job), the lints, the release
# build and the tests measured on release; with MUSL_CI=build (.github/workflows/
# release.yml), the release build alone. Where SHARDS_GPU_LIBS names a directory, the GPU's
# renderer is built into it first (scripts/gpu-libs, against Alpine's musl), if it holds
# none, and `shards` carries the GPU's VM process (D201). Packages are added as root; everything else runs
# as the user that owns the checkout, as shards runs: never as root, which permission bits
# and much else do not stop.
#
#   docker run ... -v "$PWD:/work" -w /work -e TARGET ... IMAGE scripts/musl-ci
set -eu

# Retried, as the tests' downloads are: eight times, the waits doubling from a second. A
# runner's DNS failed Alpine's index once ("DNS: transient error", CI run 38329714115).
tries=0
packages="build-base curl xz"
# The tests' leak scan runs on Python 3 (api_image.rs' leak_scan, docs/research/measurements/
# s33-leak-scan/scan.py), which rust:alpine has none of: CI run 43513425954's x86_64 job
# failed its test at the scanner's spawn, NotFound.
if [ "${MUSL_CI:-all}" != build ]; then
    packages="$packages python3"
fi
# The renderer's build: bash for its script, pkg-config and Python for meson and ninja,
# and Linux's headers (dma-buf, udmabuf).
if [ -n "${SHARDS_GPU_LIBS:-}" ]; then
    packages="$packages bash pkgconf python3 linux-headers"
fi
until apk add --no-cache $packages; do
    tries=$((tries + 1))
    if [ "$tries" -ge 8 ]; then
        echo "adding Alpine's packages failed $tries times" >&2
        exit 1
    fi
    sleep $((1 << (tries - 1)))
done
rustup component add clippy
# shards-init's C is compiled by the pinned zig (crates/shards/build.rs).
zig=$(RUNNER_TEMP=/opt GITHUB_PATH= scripts/install-zig)
chmod -R a+rX "$zig"
export PATH="$zig:$PATH"
uid=$(stat -c %u /work)
if [ "$uid" = 0 ]; then
	echo "musl-ci: /work is root's; the tests run as its owner, never as root" >&2
	exit 1
fi
adduser -D -u "$uid" -h /home/shards shards
# The image's toolchain stays where it is, read; cargo's own cache is the user's.
exec su -m shards -s /bin/sh -c '
	set -eu
	export HOME=/home/shards CARGO_HOME=/home/shards/.cargo
	part=${MUSL_CI:-all}
	if [ -n "${SHARDS_GPU_LIBS:-}" ] && [ ! -f "$SHARDS_GPU_LIBS/libvirglrenderer.a" ]; then
		scripts/gpu-libs "$SHARDS_GPU_LIBS"
	fi
	if [ "$part" = all ] || [ "$part" = release ]; then
		cargo clippy --locked --workspace --all-targets --target "$TARGET" -- -D warnings
	fi
	if [ "$part" = all ] || [ "$part" = test ]; then
		cargo test --locked --workspace --profile test-release --no-fail-fast --target "$TARGET"
	fi
	if [ "$part" != test ]; then
		cargo build --locked --release -p shards --target "$TARGET"
	fi
	if [ "$part" = all ] || [ "$part" = release ]; then
		# The stack guards, on release, which they were measured on (M159).
		cargo test --locked --release -p shards-rego --test builtins --test deep --test depth --target "$TARGET"
	fi
'
