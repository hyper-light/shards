#!/bin/sh
# CI's musl job, inside its pinned rust:alpine image on the runner's own architecture
# (.github/workflows/ci.yml, `musl`): lints, tests and builds $TARGET; with MUSL_CI=build
# (.github/workflows/release.yml), builds it alone. Packages are added
# as root; everything else runs as the user that owns the checkout, as shards runs: never
# as root, which permission bits and much else do not stop.
#
#   docker run ... -v "$PWD:/work" -w /work -e TARGET ... IMAGE scripts/musl-ci
set -eu

apk add --no-cache build-base curl xz
rustup component add clippy
# shards-init's C is compiled by the pinned zig (crates/shards/build.rs).
zig=$(RUNNER_TEMP=/opt GITHUB_PATH= scripts/install-zig)
chmod -R a+rX "$zig"
export PATH="$zig:$PATH"
uid=$(stat -c %u /work)
if [ "$uid" = 0 ]; then
	echo "musl-ci: /work is root's; the tests run as its owner, never as root" >&2
	exit 1
fi
adduser -D -u "$uid" -h /home/shards shards
# The image's toolchain stays where it is, read; cargo's own cache is the user's.
exec su -m shards -s /bin/sh -c '
	set -eu
	export HOME=/home/shards CARGO_HOME=/home/shards/.cargo
	if [ "${MUSL_CI:-}" != build ]; then
		cargo clippy --locked --workspace --all-targets --target "$TARGET" -- -D warnings
		cargo test --locked --workspace --release --no-fail-fast --target "$TARGET"
	fi
	cargo build --locked --release -p shards --target "$TARGET"
'
