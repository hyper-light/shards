#!/bin/sh
# Regenerates crates/cmdline/tests/buildx.json: buildx v0.37.1's answers to the `build`
# command lines in oracle_test.go, which crates/cmdline/tests/buildx.rs expects shards to
# give. `docker build` is buildx's `build`, run as the CLI's plugin; the test runs it the
# same way in buildx's own module, with the packages buildx vendors and the Go its go.mod
# asks for.
#
#   scripts/buildx/generate [BUILDX_CHECKOUT]
set -eu

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
tag=v0.37.1
commit=0b265a9f62db554fa9aba6dd19e1bd5704bc7d8a
bx=${1:-}
if [ -z "$bx" ]; then
	bx=$(mktemp -d)
	trap 'rm -rf "$bx"' EXIT
	git clone --quiet --depth 1 --branch "$tag" https://github.com/docker/buildx "$bx"
fi
if [ "$(git -C "$bx" rev-parse HEAD)" != "$commit" ]; then
	echo "$bx is not docker/buildx $tag ($commit)" >&2
	exit 1
fi
cp "$here/oracle_test.go" "$bx/cmd/buildx/zz_shards_oracle_test.go"
cleanup() { rm -f "$bx/cmd/buildx/zz_shards_oracle_test.go"; }
trap 'cleanup; [ -z "${1:-}" ] && rm -rf "$bx"' EXIT
cd "$bx"
SHARDS_ORACLE_OUT="$root/crates/cmdline/tests/buildx.json" \
	go test -mod=vendor -count=1 -run '^TestShardsOracle$' ./cmd/buildx/
