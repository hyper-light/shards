#!/bin/sh
# Regenerates crates/sigstore/testdata/image.json and platforms.json: images whose
# provenance attestations are signed against oracle_test.go's virtual Sigstore, each
# resolved by BuildKit's policy helpers' image.ResolveSignatureChain and verified by a
# copy of their Verifier.VerifyImage (moby/policy-helpers as buildx v0.37.1 vendors it),
# and containerd/platforms' Only, Normalize and FormatAll over a grid of platforms.
#
#   scripts/sigstore/generate-image BUILDX_V0.37.1_CHECKOUT
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
bx=$1
dir="$bx/cmd/zz_shards_image"
trap 'rm -rf "$dir"' EXIT
mkdir -p "$root/crates/sigstore/testdata" "$dir"
cp "$here/oracle_test.go" "$dir/oracle_test.go"
cp "$here/image_oracle_test.go" "$dir/image_oracle_test.go"
cd "$bx"
TZ=UTC SHARDS_IMAGE_OUT="$root/crates/sigstore/testdata/image.json" \
	SHARDS_PLATFORMS_OUT="$root/crates/sigstore/testdata/platforms.json" \
	go test -mod=vendor -count=1 -v -run '^TestShards(Image|Platforms)Oracle$' ./cmd/zz_shards_image/
