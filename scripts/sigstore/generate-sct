#!/bin/sh
# Regenerates crates/sigstore/testdata/sct.json: certificates with SCTs embedded by test
# CT logs, and their mutations, each with what sigstore-go's
# VerifySignedCertificateTimestamp, as buildx v0.37.1 vendors it, makes of it.
#
#   scripts/sigstore/generate-sct BUILDX_V0.37.1_CHECKOUT
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
bx=$1
dir="$bx/cmd/zz_shards_sct"
trap 'rm -rf "$dir"' EXIT
mkdir -p "$dir" "$root/crates/sigstore/testdata"
cp "$here/sct_oracle_test.go" "$dir/sct_oracle_test.go"
cd "$bx"
SHARDS_SCT_OUT="$root/crates/sigstore/testdata/sct.json" \
	go test -mod=vendor -count=1 -run '^TestShardsSCTOracle$' ./cmd/zz_shards_sct/
