#!/bin/sh
# Regenerates crates/sigstore/testdata/tsa.json: RFC 3161 responses built with
# digitorus/pkcs7 and encoding/asn1, valid and broken, and Sigstore's real timestamp of
# moby/buildkit v0.28.1's attestation, each with what sigstore-go's timestamping
# authority, as buildx v0.37.1 vendors it, makes of it.
#
#   scripts/sigstore/generate-tsa BUILDX_V0.37.1_CHECKOUT
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
bx=$1
dir="$bx/cmd/zz_shards_tsa"
trap 'rm -rf "$dir"' EXIT
mkdir -p "$dir" "$root/crates/sigstore/testdata"
cp "$here/tsa_oracle_test.go" "$dir/zz_shards_tsa_test.go"
cd "$bx"
SHARDS_TSA_OUT="$root/crates/sigstore/testdata/tsa.json" SHARDS_ROOT="$root" \
	go test -mod=vendor -count=1 -run '^TestShardsTSAOracle$' ./cmd/zz_shards_tsa/
