#!/bin/sh
# Regenerates crates/shards/src/build/testdata/azidentity.json: the token requests
# azidentity v1.13.1 (BuildKit v0.28.1's) makes for a client secret and a workload
# identity, run by Go 1.25.8 (D95).
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp "$here/main.go" "$work/main.go"
cd "$work"
cat >go.mod <<'MOD'
module shards.dev/azidentity-oracle

go 1.25

require (
	github.com/Azure/azure-sdk-for-go/sdk/azcore v1.20.0
	github.com/Azure/azure-sdk-for-go/sdk/azidentity v1.13.1
)
MOD
GOTOOLCHAIN=go1.25.8 GOFLAGS=-mod=mod go mod tidy >/dev/null 2>&1
GOTOOLCHAIN=go1.25.8 GOFLAGS=-mod=mod go run . "$root/crates/shards/src/build/testdata/azidentity.json"
