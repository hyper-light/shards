#!/bin/sh
# Installs the pinned zig (scripts/zig-pin: its version, and its digest for this host) for
# this host (crates/shards/build.rs compiles shards-init's C with it, through scripts/zig-cc),
# and puts it on PATH: through $GITHUB_PATH in CI, else by printing the directory. Kept where
# zig-pin says, its user's cache outside CI; one already there is kept.
set -eu
. "$(dirname "$0")/zig-pin"
if [ -z "$zig_host" ]; then
	echo "install-zig: no pinned zig for $(uname -s)-$(uname -m)" >&2
	exit 1
fi
version=$zig_version host=$zig_host sum=$zig_sum dir=$zig_home
mkdir -p "$dir"
case $host in
	*-windows) archive="zig-$host-$version.zip" ;;
	*) archive="zig-$host-$version.tar.xz" ;;
esac
bin="$dir/zig-$host-$version"
# Downloaded, checked and unpacked unless its zig is there and says its version: a copy of
# which a sweep left lib/ and doc/ alone is made whole again.
if [ "$("$bin/zig" version 2>/dev/null)" != "$version" ]; then
	curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 -o "$dir/$archive" "https://ziglang.org/download/$version/$archive"
	# The check's own words go to stderr: stdout is the directory alone, for callers that
	# take it (scripts/musl-ci).
	if command -v sha256sum >/dev/null 2>&1; then
		echo "$sum  $dir/$archive" | sha256sum -c - >&2
	else
		echo "$sum  $dir/$archive" | shasum -a 256 -c - >&2
	fi
	case $archive in
		*.zip) unzip -q -o "$dir/$archive" -d "$dir" ;;
		*) tar -xJf "$dir/$archive" -C "$dir" ;;
	esac
	rm -f "$dir/$archive"
fi
if [ -n "${GITHUB_PATH:-}" ]; then
	echo "$bin" >> "$GITHUB_PATH"
else
	echo "$bin"
fi
