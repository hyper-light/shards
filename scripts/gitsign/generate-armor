#!/bin/sh
# Regenerates crates/gitsign/testdata/armor.json: what go-crypto v1.4.1's armor.Decode,
# as buildx v0.37.1 vendors it, makes of the inputs of armor_oracle_test.go, for
# crates/gitsign/tests/adversarial.rs.
#
#   scripts/gitsign/generate-armor BUILDX_V0.37.1_CHECKOUT
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
bx=$1
trap 'rm -f "$bx/cmd/buildx/zz_shards_armor_test.go"' EXIT
cp "$here/armor_oracle_test.go" "$bx/cmd/buildx/zz_shards_armor_test.go"
cd "$bx"
SHARDS_ARMOR_OUT="$root/crates/gitsign/testdata/armor.json" \
	go test -mod=vendor -count=1 -run '^TestShardsArmor$' ./cmd/buildx/
