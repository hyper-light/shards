#!/bin/sh
# Regenerates crates/gitsign/testdata/pem.json and stdlib.json: what Go 1.26's
# encoding/pem.Decode, encoding/base64's StdEncoding.Decode and bytes.TrimSpace make of
# the inputs of stdlib_oracle_test.go, for crates/gitsign's tests. Runs with the go on
# PATH, which the test checks is of the 1.26 line.
#
#   scripts/gitsign/generate-stdlib
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp "$here/stdlib_oracle_test.go" "$work/stdlib_oracle_test.go"
printf 'module shards/stdliboracle\n\ngo 1.26\n' > "$work/go.mod"
cd "$work"
SHARDS_PEM_OUT="$root/crates/gitsign/testdata/pem.json" \
	SHARDS_STDLIB_OUT="$root/crates/gitsign/testdata/stdlib.json" \
	go test -count=1 -run '^TestShards(Pem|Stdlib)$' .
