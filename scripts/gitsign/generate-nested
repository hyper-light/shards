#!/bin/sh
# Regenerates crates/gitsign/testdata/nested.json: what go-crypto v1.4.1, as buildx
# v0.37.1 vendors it, makes of signature packets that embed signatures in turn, deep or
# malformed (nested_oracle_test.go), for crates/gitsign/tests/adversarial.rs.
#
#   scripts/gitsign/generate-nested BUILDX_V0.37.1_CHECKOUT
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
bx=$1
trap 'rm -f "$bx/cmd/buildx/zz_shards_nested_test.go"' EXIT
cp "$here/nested_oracle_test.go" "$bx/cmd/buildx/zz_shards_nested_test.go"
cd "$bx"
SHARDS_NESTED_OUT="$root/crates/gitsign/testdata/nested.json" \
	go test -mod=vendor -count=1 -run '^TestShardsNested$' ./cmd/buildx/
