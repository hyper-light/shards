#!/bin/sh
# Regenerates crates/tuf/testdata/oracle.json: TUF repositories built with go-tuf v2's
# own metadata API and Sigstore's live repository (fetched now, from the root the
# policy helpers carry), each with what go-tuf's updater, as buildx v0.37.1 vendors it,
# makes of it.
#
#   scripts/tuf/generate BUILDX_V0.37.1_CHECKOUT
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
bx=$1
trap 'rm -f "$bx/cmd/buildx/zz_shards_tuf_test.go"' EXIT
mkdir -p "$root/crates/tuf/testdata"
cp "$here/oracle_test.go" "$bx/cmd/buildx/zz_shards_tuf_test.go"
cd "$bx"
SHARDS_TUF_OUT="$root/crates/tuf/testdata/oracle.json" SHARDS_TUF_ROOT="$root/crates/tuf/roots/sigstore/root.json" \
	go test -mod=vendor -count=1 -run '^TestShardsTUFOracle$' ./cmd/buildx/
